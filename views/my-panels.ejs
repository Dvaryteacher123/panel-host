<!--
  DVARY HOSTING
  FILE: views/my-panels.ejs
  My Panels - admin panels zilizonunuliwa na user
-->
<!DOCTYPE html>
<html lang="sw">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    :root {
      --bg: #0a0612;
      --bg-2: #0f0a1f;
      --card: #150d2b;
      --card-2: #1b1138;
      --border: rgba(139, 92, 246, 0.2);
      --border-soft: rgba(139, 92, 246, 0.12);
      --purple: #8b5cf6;
      --purple-2: #a78bfa;
      --pink: #ec4899;
      --cyan: #22d3ee;
      --green: #10b981;
      --red: #ef4444;
      --yellow: #f59e0b;
      --text: #e7e3f5;
      --text-dim: #a59fc2;
      --text-mute: #6f6890;
      --sidebar-w: 250px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 15% 10%, rgba(139, 92, 246, 0.12), transparent 45%),
        radial-gradient(circle at 85% 90%, rgba(236, 72, 153, 0.1), transparent 45%);
      pointer-events: none;
      z-index: 0;
    }

    a { color: inherit; text-decoration: none; }

    /* ============== TOPBAR ============== */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 90;
      backdrop-filter: blur(14px);
      background: rgba(10, 6, 18, 0.85);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      gap: 12px;
    }

    .topbar-left { display: flex; align-items: center; gap: 12px; }

    .menu-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: 0.25s;
      font-size: 1rem;
    }

    .menu-btn:hover {
      border-color: var(--purple);
      background: rgba(139, 92, 246, 0.1);
    }

    .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 0.95rem; }

    .logo-mark {
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 900;
      color: #fff;
      font-size: 1rem;
      box-shadow: 0 0 16px rgba(139, 92, 246, 0.5);
    }

    .logo-text {
      background: linear-gradient(135deg, #fff, var(--purple-2));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: 0.4px;
      display: none;
    }

    .topbar-right { display: flex; align-items: center; gap: 10px; }

    .coins-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 7px 12px;
      border-radius: 999px;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.35);
      color: #fbbf24;
      font-size: 0.83rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .coins-badge small { color: var(--text-mute); font-weight: 500; }

    .avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 800;
      color: #fff;
      font-size: 0.85rem;
      text-transform: uppercase;
      cursor: pointer;
      border: 2px solid rgba(139, 92, 246, 0.4);
    }

    /* ============== SIDEBAR ============== */
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sidebar-w);
      background: linear-gradient(180deg, #0d0820 0%, #100a26 100%);
      border-right: 1px solid var(--border);
      padding: 20px 14px;
      z-index: 200;
      transform: translateX(-100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }

    .sidebar.open { transform: translateX(0); }

    .sidebar-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 8px 20px;
      margin-bottom: 10px;
      border-bottom: 1px solid var(--border-soft);
    }

    .sidebar-logo .logo-mark { width: 36px; height: 36px; font-size: 1.05rem; }
    .sidebar-logo .logo-text { display: block; font-weight: 800; font-size: 0.95rem; }

    .sidebar-nav { display: flex; flex-direction: column; gap: 4px; flex: 1; }

    .nav-section {
      font-size: 0.68rem;
      color: var(--text-mute);
      text-transform: uppercase;
      letter-spacing: 1.2px;
      padding: 14px 10px 6px;
      font-weight: 700;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 11px 12px;
      border-radius: 10px;
      color: var(--text-dim);
      font-size: 0.88rem;
      font-weight: 500;
      transition: 0.2s;
      position: relative;
    }

    .sidebar-link .icon { width: 20px; text-align: center; font-size: 1.05rem; }
    .sidebar-link:hover { background: rgba(139, 92, 246, 0.1); color: var(--purple-2); }

    .sidebar-link.active {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.22), rgba(236, 72, 153, 0.15));
      color: #fff;
      border: 1px solid rgba(139, 92, 246, 0.35);
      box-shadow: 0 4px 18px rgba(139, 92, 246, 0.2);
    }

    .sidebar-link.active::before {
      content: '';
      position: absolute;
      left: -14px;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 22px;
      background: linear-gradient(180deg, var(--purple), var(--pink));
      border-radius: 0 3px 3px 0;
    }

    .sidebar-footer { border-top: 1px solid var(--border-soft); padding-top: 10px; margin-top: 10px; }
    .sidebar-footer .sidebar-link { color: #f87171; }
    .sidebar-footer .sidebar-link:hover { background: rgba(239, 68, 68, 0.1); color: #fca5a5; }

    /* ============== OVERLAY ============== */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(3px);
      z-index: 150;
      opacity: 0;
      visibility: hidden;
      transition: 0.3s;
    }

    .overlay.show { opacity: 1; visibility: visible; }

    /* ============== MAIN ============== */
    .main {
      position: relative;
      z-index: 1;
      padding: 20px 16px 40px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .page-head { margin-bottom: 22px; }

    .page-head h1 {
      font-size: clamp(1.3rem, 4vw, 1.75rem);
      font-weight: 800;
      margin-bottom: 6px;
      letter-spacing: -0.3px;
    }

    .page-head h1 span {
      background: linear-gradient(135deg, var(--purple-2), var(--pink));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .page-head p { color: var(--text-dim); font-size: 0.9rem; }

    /* ============== PANEL CARDS ============== */
    .panels {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .panel-card {
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      transition: 0.3s;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .panel-card:hover {
      transform: translateY(-4px);
      border-color: rgba(139, 92, 246, 0.5);
      box-shadow: 0 12px 35px rgba(139, 92, 246, 0.2);
    }

    .panel-banner {
      height: 100px;
      background: linear-gradient(135deg, #1a0f38, #2a1560);
      display: grid;
      place-items: center;
      font-size: 2.2rem;
      color: var(--purple-2);
      overflow: hidden;
      position: relative;
    }

    .panel-banner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .purchased-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      padding: 5px 10px;
      border-radius: 999px;
      background: rgba(16, 185, 129, 0.9);
      color: #fff;
      font-size: 0.66rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      display: flex;
      align-items: center;
      gap: 4px;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.5);
      z-index: 2;
    }

    .panel-body {
      padding: 16px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .panel-name {
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.35;
    }

    .panel-desc {
      font-size: 0.82rem;
      color: var(--text-dim);
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .purchase-meta {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 12px;
      background: rgba(139, 92, 246, 0.05);
      border: 1px solid var(--border-soft);
      border-radius: 10px;
      font-size: 0.8rem;
      margin-top: 4px;
    }

    .meta-row {
      display: flex;
      justify-content: space-between;
      gap: 10px;
    }

    .meta-row .lbl { color: var(--text-mute); }
    .meta-row .vl { color: var(--text); font-weight: 700; }
    .meta-row .vl.gold {
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    /* ============== DELIVERY BOX ============== */
    .delivery-box {
      background: rgba(34, 211, 238, 0.05);
      border: 1px solid rgba(34, 211, 238, 0.2);
      border-radius: 10px;
      padding: 12px;
      margin-top: 4px;
    }

    .delivery-label {
      font-size: 0.7rem;
      color: #67e8f9;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      font-weight: 700;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .delivery-content {
      font-family: 'Courier New', monospace;
      font-size: 0.78rem;
      color: var(--text);
      word-break: break-all;
      line-height: 1.5;
      background: rgba(0, 0, 0, 0.3);
      padding: 8px 10px;
      border-radius: 6px;
      position: relative;
    }

    .copy-btn {
      position: absolute;
      top: 6px;
      right: 6px;
      padding: 3px 8px;
      border-radius: 5px;
      background: rgba(139, 92, 246, 0.3);
      border: 1px solid rgba(139, 92, 246, 0.5);
      color: var(--purple-2);
      font-size: 0.68rem;
      font-weight: 700;
      cursor: pointer;
      transition: 0.2s;
      font-family: inherit;
    }

    .copy-btn:hover {
      background: rgba(139, 92, 246, 0.5);
      color: #fff;
    }

    .no-delivery {
      font-size: 0.78rem;
      color: var(--text-mute);
      font-style: italic;
      padding: 8px 0;
      text-align: center;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 9px 14px;
      border-radius: 9px;
      font-weight: 600;
      font-size: 0.8rem;
      border: none;
      cursor: pointer;
      transition: 0.25s;
      font-family: inherit;
      text-decoration: none;
      white-space: nowrap;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--purple), var(--pink));
      color: #fff;
      box-shadow: 0 4px 18px rgba(139, 92, 246, 0.35);
      width: 100%;
      margin-top: 4px;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(139, 92, 246, 0.5);
    }

    .btn-ghost {
      background: transparent;
      color: var(--text-dim);
      border: 1px solid var(--border);
      width: 100%;
    }

    .btn-ghost:hover {
      color: var(--purple-2);
      border-color: var(--purple);
      background: rgba(139, 92, 246, 0.1);
    }

    /* ============== EMPTY ============== */
    .empty {
      text-align: center;
      padding: 50px 20px;
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px dashed var(--border);
      border-radius: 16px;
    }

    .empty-icon { font-size: 2.6rem; margin-bottom: 12px; opacity: 0.5; }
    .empty h3 { font-size: 1.05rem; margin-bottom: 8px; }
    .empty p { color: var(--text-dim); font-size: 0.88rem; margin-bottom: 14px; }

    /* ============== TOASTS ============== */
    .toast-container {
      position: fixed;
      top: 74px;
      right: 14px;
      z-index: 999;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 340px;
      width: calc(100% - 28px);
    }

    .toast {
      padding: 12px 15px;
      border-radius: 12px;
      background: var(--card-2);
      border-left: 4px solid var(--purple);
      color: var(--text);
      font-size: 0.85rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      animation: slideIn 0.35s ease;
    }

    .toast.success { border-left-color: var(--green); }
    .toast.error { border-left-color: var(--red); }
    .toast.warning { border-left-color: var(--yellow); }

    @keyframes slideIn {
      from { opacity: 0; transform: translateX(40px); }
      to { opacity: 1; transform: translateX(0); }
    }

    /* ============== RESPONSIVE ============== */
    @media (min-width: 480px) {
      .logo-text { display: block; }
      .panels { grid-template-columns: repeat(2, 1fr); }
    }

    @media (min-width: 900px) {
      .topbar { padding-left: calc(var(--sidebar-w) + 20px); }
      .sidebar { transform: translateX(0); }
      .menu-btn { display: none; }
      .main { padding: 26px 30px 60px; margin-left: var(--sidebar-w); max-width: none; }
      .overlay { display: none; }
      .panels { grid-template-columns: repeat(3, 1fr); }
    }
  </style>
</head>
<body>

  <!-- ============== TOASTS ============== -->
  <% if (success && success.length > 0) { %>
    <div class="toast-container">
      <% success.forEach((msg) => { %>
        <div class="toast success"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="toast-container">
      <% error.forEach((msg) => { %>
        <div class="toast error"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (warning && warning.length > 0) { %>
    <div class="toast-container">
      <% warning.forEach((msg) => { %>
        <div class="toast warning"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>

  <!-- ============== OVERLAY ============== -->
  <div class="overlay" id="overlay" onclick="closeSidebar()"></div>

  <!-- ============== SIDEBAR ============== -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-mark">D</div>
      <div class="logo-text">DVARY HOSTING</div>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section">Menu</div>

      <a href="/dashboard" class="sidebar-link">
        <span class="icon">🏠</span> Dashboard
      </a>
      <a href="/bots" class="sidebar-link">
        <span class="icon">🤖</span> Deploy Bots
      </a>
      <a href="/deploy" class="sidebar-link">
        <span class="icon">🚀</span> My Deployments
      </a>
      <a href="/servers/buy" class="sidebar-link">
        <span class="icon">🛒</span> Buy Server
      </a>
      <a href="/servers" class="sidebar-link">
        <span class="icon">🖥️</span> My Servers
      </a>
      <a href="/servers/admin-panels" class="sidebar-link">
        <span class="icon">🛡️</span> Admin Panels
      </a>
      <a href="/servers/my-panels" class="sidebar-link active">
        <span class="icon">📦</span> My Panels
      </a>

      <div class="nav-section">Akaunti</div>

      <a href="/coins" class="sidebar-link">
        <span class="icon">🪙</span> Coins
      </a>
      <a href="/coins/transactions" class="sidebar-link">
        <span class="icon">📊</span> Transactions
      </a>
      <a href="/dashboard/profile" class="sidebar-link">
        <span class="icon">👤</span> Profile
      </a>
      <a href="/dashboard/settings" class="sidebar-link">
        <span class="icon">⚙️</span> Settings
      </a>
    </nav>

    <div class="sidebar-footer">
      <% if (isAdmin) { %>
        <a href="/admin/dashboard" class="sidebar-link">
          <span class="icon">🔑</span> Admin Panel
        </a>
      <% } %>
      <a href="/auth/logout" class="sidebar-link">
        <span class="icon">🚪</span> Logout
      </a>
    </div>
  </aside>

  <!-- ============== TOPBAR ============== -->
  <header class="topbar">
    <div class="topbar-left">
      <button class="menu-btn" onclick="openSidebar()" aria-label="Menu">☰</button>
      <div class="logo">
        <div class="logo-mark">D</div>
        <span class="logo-text">DVARY HOSTING</span>
      </div>
    </div>

    <div class="topbar-right">
      <a href="/coins" class="coins-badge">
        🪙 <%= user.coins %> <small>coins</small>
      </a>
      <a href="/dashboard/profile" class="avatar" title="<%= user.username %>">
        <%= user.username.charAt(0) %>
      </a>
    </div>
  </header>

  <!-- ============== MAIN ============== -->
  <main class="main">

    <div class="page-head">
      <h1>My <span>Panels</span> 📦</h1>
      <p>Admin panels zote ulizonunua zinaonekana hapa.</p>
    </div>

    <% if (myPanels && myPanels.length > 0) { %>
      <div class="panels">
        <% myPanels.forEach((item) => { %>
          <% const panel = item.panel; %>
          <% const tx = item.transaction; %>
          <div class="panel-card">

            <div class="panel-banner">
              <% if (panel.image) { %>
                <img src="<%= panel.image %>" alt="<%= panel.name %>" loading="lazy" />
              <% } else { %>
                🛡️
              <% } %>
              <div class="purchased-badge">✅ Imenunuliwa</div>
            </div>

            <div class="panel-body">
              <h3 class="panel-name"><%= panel.name %></h3>
              <p class="panel-desc"><%= panel.shortDescription || panel.description %></p>

              <div class="purchase-meta">
                <div class="meta-row">
                  <span class="lbl">Bei</span>
                  <span class="vl gold"><%= tx.amount %> coins</span>
                </div>
                <div class="meta-row">
                  <span class="lbl">Tarehe</span>
                  <span class="vl">
                    <%= new Date(tx.createdAt).toLocaleDateString('sw-TZ', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  </span>
                </div>
              </div>

              <% if (panel.downloadUrl) { %>
                <div class="delivery-box">
                  <div class="delivery-label">🔗 Download URL</div>
                  <div class="delivery-content" style="padding-right: 54px;">
                    <%= panel.downloadUrl %>
                    <button type="button" class="copy-btn" onclick="copyText('<%= panel.downloadUrl.replace(/'/g, "\\'") %>', this)">Nakili</button>
                  </div>
                </div>
              <% } %>

              <% if (panel.deploymentInfo) { %>
                <div class="delivery-box">
                  <div class="delivery-label">📋 Deployment Info</div>
                  <div class="delivery-content"><%= panel.deploymentInfo %></div>
                </div>
              <% } %>

              <% if (!panel.downloadUrl && !panel.deploymentInfo) { %>
                <div class="no-delivery">Hakuna taarifa za delivery zilizowekwa kwa panel hii.</div>
              <% } %>

              <% if (panel.downloadUrl) { %>
                <a href="<%= panel.downloadUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                  ⬇️ Pakua / Fungua
                </a>
              <% } %>
            </div>

          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty">
        <div class="empty-icon">📦</div>
        <h3>Hakuna panels bado</h3>
        <p>Bado hujanunua admin panel yoyote.</p>
        <a href="/servers/admin-panels" class="btn btn-primary" style="max-width: 240px; margin: 0 auto;">Nunua Panel →</a>
      </div>
    <% } %>

  </main>

  <script>
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');

    function openSidebar() {
      sidebar.classList.add('open');
      overlay.classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      sidebar.classList.remove('open');
      overlay.classList.remove('show');
      document.body.style.overflow = '';
    }

    function copyText(text, btn) {
      navigator.clipboard.writeText(text).then(() => {
        const original = btn.textContent;
        btn.textContent = '✅';
        setTimeout(() => { btn.textContent = original; }, 1200);
      }).catch(() => {
        alert('Imeshindwa kunakili. Nakili manually: ' + text);
      });
    }

    setTimeout(() => {
      document.querySelectorAll('.toast').forEach((el) => {
        el.style.transition = 'opacity 0.4s, transform 0.4s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(40px)';
        setTimeout(() => el.remove(), 400);
      });
    }, 4000);

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 900) closeSidebar();
    });
  </script>
</body>
</html>
