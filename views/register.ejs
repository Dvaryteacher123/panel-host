<!--
  DVARY HOSTING
  FILE: views/register.ejs
  Register page
-->
<!DOCTYPE html>
<html lang="sw">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    :root {
      --bg: #0a0612;
      --bg-2: #0f0a1f;
      --card: #150d2b;
      --card-2: #1b1138;
      --border: rgba(139, 92, 246, 0.2);
      --purple: #8b5cf6;
      --purple-2: #a78bfa;
      --pink: #ec4899;
      --cyan: #22d3ee;
      --green: #10b981;
      --red: #ef4444;
      --text: #e7e3f5;
      --text-dim: #a59fc2;
      --text-mute: #6f6890;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 20% 15%, rgba(139, 92, 246, 0.2), transparent 45%),
        radial-gradient(circle at 80% 85%, rgba(236, 72, 153, 0.15), transparent 45%);
      pointer-events: none;
      z-index: 0;
    }

    a { color: var(--purple-2); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* ============== WRAPPER ============== */
    .auth-wrap {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px 18px;
    }

    /* ============== CARD ============== */
    .auth-card {
      width: 100%;
      max-width: 460px;
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 32px 24px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.55), 0 0 40px rgba(139, 92, 246, 0.1);
      animation: fadeUp 0.5s ease;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============== LOGO ============== */
    .auth-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 22px;
      font-weight: 800;
      font-size: 1.05rem;
    }

    .logo-mark {
      width: 38px;
      height: 38px;
      border-radius: 11px;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 900;
      color: #fff;
      font-size: 1.15rem;
      box-shadow: 0 0 22px rgba(139, 92, 246, 0.55);
    }

    .logo-text {
      background: linear-gradient(135deg, #fff, var(--purple-2));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: 0.4px;
    }

    /* ============== HEADINGS ============== */
    .auth-card h1 {
      font-size: 1.5rem;
      font-weight: 800;
      text-align: center;
      margin-bottom: 8px;
    }

    .auth-card .subtitle {
      text-align: center;
      color: var(--text-dim);
      font-size: 0.9rem;
      margin-bottom: 26px;
    }

    /* ============== ALERTS ============== */
    .alert {
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 0.85rem;
      margin-bottom: 16px;
      line-height: 1.5;
      border-left: 4px solid var(--purple);
      background: rgba(139, 92, 246, 0.08);
    }

    .alert.error {
      border-left-color: var(--red);
      background: rgba(239, 68, 68, 0.08);
      color: #fca5a5;
    }

    .alert ul {
      margin: 0;
      padding-left: 18px;
    }

    .alert li { margin-bottom: 3px; }
    .alert li:last-child { margin-bottom: 0; }

    /* ============== FORM ============== */
    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-dim);
      margin-bottom: 7px;
      letter-spacing: 0.3px;
    }

    .input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 10px;
      background: rgba(10, 6, 18, 0.6);
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 0.92rem;
      font-family: inherit;
      transition: 0.25s;
      outline: none;
    }

    .input:focus {
      border-color: var(--purple);
      box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
      background: rgba(10, 6, 18, 0.85);
    }

    .input::placeholder { color: var(--text-mute); }

    /* ============== PASSWORD TOGGLE ============== */
    .input-wrap {
      position: relative;
    }

    .input-wrap .toggle {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: var(--text-mute);
      cursor: pointer;
      font-size: 0.78rem;
      padding: 4px 6px;
      font-weight: 600;
      letter-spacing: 0.3px;
    }

    .input-wrap .toggle:hover { color: var(--purple-2); }

    /* ============== PASSWORD STRENGTH ============== */
    .strength {
      height: 4px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.06);
      margin-top: 8px;
      overflow: hidden;
    }

    .strength-bar {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      background: var(--red);
      transition: all 0.35s;
    }

    .strength-bar.weak { width: 33%; background: var(--red); }
    .strength-bar.medium { width: 66%; background: #f59e0b; }
    .strength-bar.strong { width: 100%; background: var(--green); }

    .strength-text {
      font-size: 0.72rem;
      color: var(--text-mute);
      margin-top: 5px;
      letter-spacing: 0.3px;
    }

    /* ============== BUTTONS ============== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 12px 18px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.92rem;
      border: none;
      cursor: pointer;
      transition: all 0.25s;
      width: 100%;
      font-family: inherit;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--purple), var(--pink));
      color: #fff;
      box-shadow: 0 4px 20px rgba(139, 92, 246, 0.4);
      margin-top: 8px;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(139, 92, 246, 0.55);
    }

    .btn-primary:active { transform: translateY(0); }

    .btn-primary:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    /* ============== FOOTER LINK ============== */
    .auth-footer {
      text-align: center;
      margin-top: 20px;
      font-size: 0.87rem;
      color: var(--text-dim);
    }

    .auth-footer a {
      color: var(--purple-2);
      font-weight: 600;
    }

    /* ============== CHECKBOX ============== */
    .checkbox-wrap {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 16px;
      font-size: 0.83rem;
      color: var(--text-dim);
      line-height: 1.45;
    }

    .checkbox-wrap input[type="checkbox"] {
      accent-color: var(--purple);
      width: 16px;
      height: 16px;
      margin-top: 2px;
      cursor: pointer;
      flex-shrink: 0;
    }

    /* ============== LOADING SPINNER ============== */
    .spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      display: none;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .btn-primary.loading .spinner { display: inline-block; }
    .btn-primary.loading .btn-text { display: none; }

    /* ============== RESPONSIVE ============== */
    @media (min-width: 480px) {
      .auth-card { padding: 40px 34px; }
    }
  </style>
</head>
<body>

  <!-- ============== AUTH CARD ============== -->
  <div class="auth-wrap">
    <div class="auth-card">

      <a href="/" class="auth-logo">
        <div class="logo-mark">D</div>
        <span class="logo-text">DVARY HOSTING</span>
      </a>

      <h1>Unda Akaunti</h1>
      <p class="subtitle">Jisajili bure na uanze kutumia DVARY HOSTING</p>

      <% if (errors && errors.length > 0) { %>
        <div class="alert error">
          <ul>
            <% errors.forEach((err) => { %>
              <li><%= err %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form action="/auth/register" method="POST" id="registerForm">
        <div class="form-group">
          <label for="username">Username</label>
          <input
            type="text"
            id="username"
            name="username"
            class="input"
            placeholder="jina_lako"
            value="<%= old && old.username ? old.username : '' %>"
            required
            minlength="3"
            maxlength="30"
            pattern="[a-zA-Z0-9_]+"
            title="Herufi, namba au underscore pekee"
            autofocus
          />
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            class="input"
            placeholder="wewe@example.com"
            value="<%= old && old.email ? old.email : '' %>"
            required
          />
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <div class="input-wrap">
            <input
              type="password"
              id="password"
              name="password"
              class="input"
              placeholder="••••••••"
              required
              minlength="8"
              oninput="checkStrength(this.value)"
            />
            <button type="button" class="toggle" onclick="togglePassword('password', event)">Onyesha</button>
          </div>
          <div class="strength">
            <div class="strength-bar" id="strengthBar"></div>
          </div>
          <div class="strength-text" id="strengthText">Angalau herufi 8</div>
        </div>

        <div class="form-group">
          <label for="confirmPassword">Rudia Password</label>
          <div class="input-wrap">
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              class="input"
              placeholder="••••••••"
              required
              minlength="8"
            />
            <button type="button" class="toggle" onclick="togglePassword('confirmPassword', event)">Onyesha</button>
          </div>
        </div>

        <div class="checkbox-wrap">
          <input type="checkbox" id="terms" name="terms" required />
          <label for="terms" style="margin: 0; cursor: pointer;">
            Nakubali masharti ya DVARY HOSTING na sera za matumizi.
          </label>
        </div>

        <button type="submit" class="btn btn-primary" id="submitBtn">
          <span class="btn-text">Jisajili →</span>
          <span class="spinner"></span>
        </button>
      </form>

      <div class="auth-footer">
        Una akaunti tayari?
        <a href="/auth/login">Ingia hapa</a>
      </div>

    </div>
  </div>

  <script>
    // Toggle password visibility
    function togglePassword(id, event) {
      const input = document.getElementById(id);
      const btn = event.target;
      if (input.type === 'password') {
        input.type = 'text';
        btn.textContent = 'Ficha';
      } else {
        input.type = 'password';
        btn.textContent = 'Onyesha';
      }
    }

    // Password strength indicator
    function checkStrength(value) {
      const bar = document.getElementById('strengthBar');
      const text = document.getElementById('strengthText');
      const score = getScore(value);

      bar.className = 'strength-bar';
      if (value.length === 0) {
        text.textContent = 'Angalau herufi 8';
        return;
      }

      if (score <= 2) {
        bar.classList.add('weak');
        text.textContent = 'Dhaifu';
      } else if (score === 3 || score === 4) {
        bar.classList.add('medium');
        text.textContent = 'Wastani';
      } else {
        bar.classList.add('strong');
        text.textContent = 'Imara';
      }
    }

    function getScore(pwd) {
      let score = 0;
      if (pwd.length >= 8) score++;
      if (pwd.length >= 12) score++;
      if (/[A-Z]/.test(pwd)) score++;
      if (/[0-9]/.test(pwd)) score++;
      if (/[^A-Za-z0-9]/.test(pwd)) score++;
      return score;
    }

    // Loading state kwenye submit
    document.getElementById('registerForm').addEventListener('submit', function (e) {
      const pwd = document.getElementById('password').value;
      const confirm = document.getElementById('confirmPassword').value;

      if (pwd !== confirm) {
        e.preventDefault();
        alert('Password na confirm password hazifanani.');
        return;
      }

      const btn = document.getElementById('submitBtn');
      btn.classList.add('loading');
      btn.disabled = true;
    });
  </script>
</body>
</html>
