<!--
  DVARY HOSTING
  FILE: views/admin/transactions.ejs
  Admin - Transactions log (view only)
-->
<!DOCTYPE html>
<html lang="sw">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    :root {
      --bg: #0a0612;
      --bg-2: #0f0a1f;
      --card: #150d2b;
      --card-2: #1b1138;
      --border: rgba(139, 92, 246, 0.2);
      --border-soft: rgba(139, 92, 246, 0.12);
      --purple: #8b5cf6;
      --purple-2: #a78bfa;
      --pink: #ec4899;
      --cyan: #22d3ee;
      --green: #10b981;
      --red: #ef4444;
      --yellow: #f59e0b;
      --text: #e7e3f5;
      --text-dim: #a59fc2;
      --text-mute: #6f6890;
      --sidebar-w: 260px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 15% 10%, rgba(139, 92, 246, 0.12), transparent 45%),
        radial-gradient(circle at 85% 90%, rgba(236, 72, 153, 0.1), transparent 45%);
      pointer-events: none;
      z-index: 0;
    }

    a { color: inherit; text-decoration: none; }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 90;
      backdrop-filter: blur(14px);
      background: rgba(10, 6, 18, 0.85);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      gap: 12px;
    }

    .topbar-left { display: flex; align-items: center; gap: 12px; }

    .menu-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: 0.25s;
      font-size: 1rem;
    }

    .menu-btn:hover {
      border-color: var(--purple);
      background: rgba(139, 92, 246, 0.1);
    }

    .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 0.95rem; }

    .logo-mark {
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 900;
      color: #fff;
      font-size: 1rem;
      box-shadow: 0 0 16px rgba(139, 92, 246, 0.5);
    }

    .logo-text {
      background: linear-gradient(135deg, #fff, var(--purple-2));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: 0.4px;
      display: none;
    }

    .admin-tag {
      display: none;
      align-items: center;
      gap: 5px;
      padding: 3px 9px;
      border-radius: 999px;
      background: rgba(236, 72, 153, 0.15);
      border: 1px solid rgba(236, 72, 153, 0.35);
      color: #f472b6;
      font-size: 0.65rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-left: 4px;
    }

    .topbar-right { display: flex; align-items: center; gap: 10px; }

    .user-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px 6px 6px;
      border-radius: 999px;
      background: rgba(139, 92, 246, 0.1);
      border: 1px solid var(--border);
      transition: 0.25s;
    }

    .user-btn:hover { border-color: var(--purple); }

    .user-avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 800;
      color: #fff;
      font-size: 0.78rem;
      text-transform: uppercase;
    }

    .user-name { font-size: 0.83rem; font-weight: 700; display: none; }

    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sidebar-w);
      background: linear-gradient(180deg, #0d0820 0%, #100a26 100%);
      border-right: 1px solid var(--border);
      padding: 20px 14px;
      z-index: 200;
      transform: translateX(-100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }

    .sidebar.open { transform: translateX(0); }

    .sidebar-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 8px 20px;
      margin-bottom: 10px;
      border-bottom: 1px solid var(--border-soft);
    }

    .sidebar-logo .logo-mark { width: 36px; height: 36px; font-size: 1.05rem; }
    .sidebar-logo .logo-text { display: block; font-weight: 800; font-size: 0.95rem; }

    .sidebar-badge {
      display: inline-block;
      margin: 0 8px 12px;
      padding: 5px 10px;
      border-radius: 8px;
      background: linear-gradient(135deg, rgba(236, 72, 153, 0.15), rgba(139, 92, 246, 0.15));
      border: 1px solid rgba(236, 72, 153, 0.3);
      color: #f472b6;
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      text-align: center;
    }

    .sidebar-nav { display: flex; flex-direction: column; gap: 4px; flex: 1; }

    .nav-section {
      font-size: 0.68rem;
      color: var(--text-mute);
      text-transform: uppercase;
      letter-spacing: 1.2px;
      padding: 14px 10px 6px;
      font-weight: 700;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 11px 12px;
      border-radius: 10px;
      color: var(--text-dim);
      font-size: 0.88rem;
      font-weight: 500;
      transition: 0.2s;
      position: relative;
    }

    .sidebar-link .icon { width: 20px; text-align: center; font-size: 1.05rem; }
    .sidebar-link:hover { background: rgba(139, 92, 246, 0.1); color: var(--purple-2); }

    .sidebar-link.active {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.22), rgba(236, 72, 153, 0.15));
      color: #fff;
      border: 1px solid rgba(139, 92, 246, 0.35);
      box-shadow: 0 4px 18px rgba(139, 92, 246, 0.2);
    }

    .sidebar-link.active::before {
      content: '';
      position: absolute;
      left: -14px;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 22px;
      background: linear-gradient(180deg, var(--purple), var(--pink));
      border-radius: 0 3px 3px 0;
    }

    .sidebar-footer { border-top: 1px solid var(--border-soft); padding-top: 10px; margin-top: 10px; }
    .sidebar-footer .sidebar-link { color: #f87171; }
    .sidebar-footer .sidebar-link:hover { background: rgba(239, 68, 68, 0.1); color: #fca5a5; }

    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(3px);
      z-index: 150;
      opacity: 0;
      visibility: hidden;
      transition: 0.3s;
    }

    .overlay.show { opacity: 1; visibility: visible; }

    .main {
      position: relative;
      z-index: 1;
      padding: 20px 16px 40px;
      max-width: 1300px;
      margin: 0 auto;
    }

    .page-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 22px;
      flex-wrap: wrap;
    }

    .page-head h1 {
      font-size: clamp(1.3rem, 4vw, 1.75rem);
      font-weight: 800;
      margin-bottom: 6px;
      letter-spacing: -0.3px;
    }

    .page-head h1 span {
      background: linear-gradient(135deg, var(--purple-2), var(--pink));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .page-head p { color: var(--text-dim); font-size: 0.9rem; }

    .filters-card {
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px;
      margin-bottom: 18px;
    }

    .filter-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }

    .filter-select {
      padding: 10px 12px;
      border-radius: 10px;
      background: rgba(10, 6, 18, 0.6);
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 0.85rem;
      font-family: inherit;
      outline: none;
      cursor: pointer;
      flex: 1;
      min-width: 140px;
    }

    .filter-select:focus { border-color: var(--purple); }
    .filter-select option { background: var(--card-2); color: var(--text); }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px 16px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.83rem;
      border: none;
      cursor: pointer;
      transition: 0.25s;
      font-family: inherit;
      text-decoration: none;
      white-space: nowrap;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--purple), var(--pink));
      color: #fff;
      box-shadow: 0 4px 18px rgba(139, 92, 246, 0.35);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(139, 92, 246, 0.5);
    }

    .btn-ghost {
      background: transparent;
      color: var(--text-dim);
      border: 1px solid var(--border);
    }

    .btn-ghost:hover {
      color: var(--purple-2);
      border-color: var(--purple);
      background: rgba(139, 92, 246, 0.1);
    }

    .results-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 12px;
      font-size: 0.85rem;
      color: var(--text-dim);
      flex-wrap: wrap;
    }

    .results-meta strong { color: var(--purple-2); }

    .tx-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .tx-card {
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px;
      transition: 0.25s;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .tx-card:hover {
      transform: translateY(-2px);
      border-color: rgba(139, 92, 246, 0.5);
      box-shadow: 0 8px 22px rgba(139, 92, 246, 0.15);
    }

    .tx-main {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .tx-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      font-size: 1.15rem;
      flex-shrink: 0;
    }

    .tx-icon.credit {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(34, 211, 238, 0.15));
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .tx-icon.debit {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(245, 158, 11, 0.15));
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .tx-info { flex: 1; min-width: 0; }

    .tx-title {
      font-size: 0.9rem;
      font-weight: 700;
      margin-bottom: 3px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .tx-sub {
      font-size: 0.75rem;
      color: var(--text-mute);
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .tx-sub .sep { opacity: 0.5; }
    .tx-sub .user-link { color: var(--purple-2); font-weight: 700; }
    .tx-sub .user-link:hover { color: var(--pink); }
    .tx-sub .admin-link {
      color: #f472b6;
      font-weight: 700;
      font-size: 0.72rem;
    }

    .tx-amount {
      text-align: right;
      flex-shrink: 0;
    }

    .amount-value {
      font-size: 1.05rem;
      font-weight: 800;
      line-height: 1.2;
    }

    .amount-value.credit { color: #34d399; }
    .amount-value.debit { color: #f87171; }

    .tx-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      padding-top: 10px;
      border-top: 1px dashed var(--border-soft);
      font-size: 0.75rem;
      color: var(--text-mute);
      flex-wrap: wrap;
    }

    .tx-footer .balance {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .tx-footer .balance strong { color: var(--text); font-weight: 700; }

    .badge {
      display: inline-block;
      font-size: 0.66rem;
      padding: 3px 9px;
      border-radius: 999px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      white-space: nowrap;
    }

    .badge-success { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
    .badge-pending { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
    .badge-failed  { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
    .badge-info    { background: rgba(34, 211, 238, 0.15); color: #67e8f9; border: 1px solid rgba(34, 211, 238, 0.3); }
    .badge-neutral { background: rgba(139, 92, 246, 0.15); color: var(--purple-2); border: 1px solid rgba(139, 92, 246, 0.3); }

    .reason-tag {
      font-size: 0.66rem;
      padding: 3px 8px;
      border-radius: 6px;
      background: rgba(139, 92, 246, 0.1);
      color: var(--purple-2);
      border: 1px solid rgba(139, 92, 246, 0.22);
      font-weight: 700;
      text-transform: capitalize;
      white-space: nowrap;
    }

    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 22px;
    }

    .page-link {
      padding: 8px 13px;
      border-radius: 9px;
      background: rgba(139, 92, 246, 0.08);
      border: 1px solid var(--border);
      color: var(--text-dim);
      font-size: 0.82rem;
      font-weight: 600;
      transition: 0.2s;
    }

    .page-link:hover {
      border-color: var(--purple);
      color: var(--purple-2);
      background: rgba(139, 92, 246, 0.15);
    }

    .page-link.active {
      background: linear-gradient(135deg, var(--purple), var(--pink));
      border-color: transparent;
      color: #fff;
      box-shadow: 0 4px 16px rgba(139, 92, 246, 0.4);
    }

    .page-info {
      font-size: 0.8rem;
      color: var(--text-mute);
      width: 100%;
      text-align: center;
      margin-top: 8px;
    }

    .empty {
      text-align: center;
      padding: 50px 20px;
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px dashed var(--border);
      border-radius: 16px;
    }

    .empty-icon { font-size: 2.6rem; margin-bottom: 12px; opacity: 0.5; }
    .empty h3 { font-size: 1.05rem; margin-bottom: 8px; }
    .empty p { color: var(--text-dim); font-size: 0.88rem; }

    .toast-container {
      position: fixed;
      top: 74px;
      right: 14px;
      z-index: 999;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 340px;
      width: calc(100% - 28px);
    }

    .toast {
      padding: 12px 15px;
      border-radius: 12px;
      background: var(--card-2);
      border-left: 4px solid var(--purple);
      color: var(--text);
      font-size: 0.85rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      animation: slideIn 0.35s ease;
    }

    .toast.success { border-left-color: var(--green); }
    .toast.error { border-left-color: var(--red); }
    .toast.warning { border-left-color: var(--yellow); }

    @keyframes slideIn {
      from { opacity: 0; transform: translateX(40px); }
      to { opacity: 1; transform: translateX(0); }
    }

    @media (min-width: 480px) {
      .logo-text { display: block; }
      .admin-tag { display: inline-flex; }
      .user-name { display: block; }
      .filter-select { flex: 0 1 auto; min-width: 160px; }
    }

    @media (min-width: 900px) {
      .topbar { padding-left: calc(var(--sidebar-w) + 20px); }
      .sidebar { transform: translateX(0); }
      .menu-btn { display: none; }
      .main { padding: 26px 30px 60px; margin-left: var(--sidebar-w); max-width: none; }
      .overlay { display: none; }
    }
  </style>
</head>
<body>

  <% if (success && success.length > 0) { %>
    <div class="toast-container">
      <% success.forEach((msg) => { %>
        <div class="toast success"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="toast-container">
      <% error.forEach((msg) => { %>
        <div class="toast error"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (warning && warning.length > 0) { %>
    <div class="toast-container">
      <% warning.forEach((msg) => { %>
        <div class="toast warning"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>

  <div class="overlay" id="overlay" onclick="closeSidebar()"></div>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-mark">D</div>
      <div class="logo-text">DVARY HOSTING</div>
    </div>
    <div class="sidebar-badge">🔑 Admin Panel</div>

    <nav class="sidebar-nav">
      <div class="nav-section">Usimamizi</div>

      <a href="/admin/dashboard" class="sidebar-link">
        <span class="icon">📊</span> Dashboard
      </a>
      <a href="/admin/users" class="sidebar-link">
        <span class="icon">👥</span> Users
      </a>
      <a href="/admin/bots" class="sidebar-link">
        <span class="icon">🤖</span> Bots
      </a>
      <a href="/admin/deployments" class="sidebar-link">
        <span class="icon">🚀</span> Deployments
      </a>
      <a href="/admin/servers" class="sidebar-link">
        <span class="icon">🖥️</span> Servers
      </a>

      <div class="nav-section">Bidhaa</div>

      <a href="/admin/hosting-plans" class="sidebar-link">
        <span class="icon">📦</span> Hosting Plans
      </a>
      <a href="/admin/admin-panels" class="sidebar-link">
        <span class="icon">🛡️</span> Admin Panels
      </a>

      <div class="nav-section">Fedha</div>

      <a href="/admin/transactions" class="sidebar-link active">
        <span class="icon">💰</span> Transactions
      </a>

      <div class="nav-section">Mfumo</div>

      <a href="/admin/settings" class="sidebar-link">
        <span class="icon">⚙️</span> Settings
      </a>
    </nav>

    <div class="sidebar-footer">
      <a href="/dashboard" class="sidebar-link">
        <span class="icon">👤</span> User View
      </a>
      <a href="/auth/logout" class="sidebar-link">
        <span class="icon">🚪</span> Logout
      </a>
    </div>
  </aside>

  <header class="topbar">
    <div class="topbar-left">
      <button class="menu-btn" onclick="openSidebar()" aria-label="Menu">☰</button>
      <div class="logo">
        <div class="logo-mark">D</div>
        <span class="logo-text">DVARY HOSTING</span>
        <span class="admin-tag">🔑 Admin</span>
      </div>
    </div>

    <div class="topbar-right">
      <a href="/dashboard/profile" class="user-btn">
        <div class="user-avatar"><%= user.username.charAt(0) %></div>
        <span class="user-name"><%= user.username %></span>
      </a>
    </div>
  </header>

  <main class="main">

    <div class="page-head">
      <div>
        <h1>Transactions <span>Log</span> 💰</h1>
        <p>Kumbukumbu ya kila coin transaction iliyofanyika kwenye mfumo.</p>
      </div>
    </div>

    <form class="filters-card" method="GET" action="/admin/transactions">
      <div class="filter-group">
        <select name="type" class="filter-select">
          <option value="" <%= !filters.type || filters.type === 'all' ? 'selected' : '' %>>Aina: Zote</option>
          <option value="credit" <%= filters.type === 'credit' ? 'selected' : '' %>>Credits (+)</option>
          <option value="debit" <%= filters.type === 'debit' ? 'selected' : '' %>>Debits (-)</option>
        </select>

        <select name="reason" class="filter-select">
          <option value="" <%= !filters.reason || filters.reason === 'all' ? 'selected' : '' %>>Sababu: Zote</option>
          <option value="admin-add" <%= filters.reason === 'admin-add' ? 'selected' : '' %>>Admin Add</option>
          <option value="admin-remove" <%= filters.reason === 'admin-remove' ? 'selected' : '' %>>Admin Remove</option>
          <option value="bot-deployment" <%= filters.reason === 'bot-deployment' ? 'selected' : '' %>>Bot Deployment</option>
          <option value="server-purchase" <%= filters.reason === 'server-purchase' ? 'selected' : '' %>>Server Purchase</option>
          <option value="admin-panel-purchase" <%= filters.reason === 'admin-panel-purchase' ? 'selected' : '' %>>Admin Panel</option>
          <option value="refund" <%= filters.reason === 'refund' ? 'selected' : '' %>>Refund</option>
        </select>

        <button type="submit" class="btn btn-primary">Chuja</button>
        <a href="/admin/transactions" class="btn btn-ghost">Reset</a>
      </div>
    </form>

    <div class="results-meta">
      <div>Transactions <strong><%= transactions.length %></strong> zimepatikana</div>
      <div>Jumla: <strong><%= pagination.total %></strong></div>
    </div>

    <% if (transactions && transactions.length > 0) { %>
      <div class="tx-list">
        <% transactions.forEach((t) => { %>
          <div class="tx-card">

            <div class="tx-main">
              <div class="tx-icon <%= t.type %>">
                <%= t.type === 'credit' ? '📥' : '📤' %>
              </div>
              <div class="tx-info">
                <div class="tx-title"><%= t.description || t.reason %></div>
                <div class="tx-sub">
                  <span>
                    <% if (t.user) { %>
                      <a href="/admin/users/<%= t.user._id %>" class="user-link"><%= t.user.username %></a>
                    <% } else { %>
                      unknown
                    <% } %>
                  </span>
                  <span class="sep">•</span>
                  <span>
                    <%= new Date(t.createdAt).toLocaleString('sw-TZ', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                  </span>
                  <% if (t.performedBy && t.performedBy.username) { %>
                    <span class="sep">•</span>
                    <span>na <span class="admin-link"><%= t.performedBy.username %></span></span>
                  <% } %>
                </div>
              </div>
              <div class="tx-amount">
                <div class="amount-value <%= t.type === 'credit' ? 'credit' : 'debit' %>">
                  <%= t.type === 'credit' ? '+' : '-' %><%= t.amount %>
                </div>
              </div>
            </div>

            <div class="tx-footer">
              <div class="balance">
                Balance:
                <strong><%= t.balanceBefore %></strong>
                →
                <strong><%= t.balanceAfter %></strong>
              </div>

              <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
                <span class="reason-tag"><%= (t.reason || '').replace(/-/g, ' ') %></span>

                <% if (t.status === 'completed') { %>
                  <span class="badge badge-success">Completed</span>
                <% } else if (t.status === 'pending') { %>
                  <span class="badge badge-pending">Pending</span>
                <% } else if (t.status === 'failed') { %>
                  <span class="badge badge-failed">Failed</span>
                <% } else if (t.status === 'reversed') { %>
                  <span class="badge badge-neutral">Reversed</span>
                <% } else { %>
                  <span class="badge badge-info"><%= t.status %></span>
                <% } %>
              </div>
            </div>

          </div>
        <% }); %>
      </div>

      <% if (pagination.totalPages > 1) { %>
        <div class="pagination">
          <% if (pagination.hasPrev) { %>
            <a
              href="/admin/transactions?page=<%= pagination.currentPage - 1 %><%= filters.type && filters.type !== 'all' ? '&type=' + filters.type : '' %><%= filters.reason && filters.reason !== 'all' ? '&reason=' + filters.reason : '' %>"
              class="page-link"
            >← Nyuma</a>
          <% } %>

          <span class="page-link active"><%= pagination.currentPage %> / <%= pagination.totalPages %></span>

          <% if (pagination.hasNext) { %>
            <a
              href="/admin/transactions?page=<%= pagination.currentPage + 1 %><%= filters.type && filters.type !== 'all' ? '&type=' + filters.type : '' %><%= filters.reason && filters.reason !== 'all' ? '&reason=' + filters.reason : '' %>"
              class="page-link"
            >Mbele →</a>
          <% } %>

          <div class="page-info">Ukurasa <%= pagination.currentPage %> kati ya <%= pagination.totalPages %></div>
        </div>
      <% } %>

    <% } else { %>
      <div class="empty">
        <div class="empty-icon">💰</div>
        <h3>Hakuna transactions</h3>
        <p>
          <% if ((filters.type && filters.type !== 'all') || (filters.reason && filters.reason !== 'all')) { %>
            Hakuna transactions zinazolingana na filters zako.
          <% } else { %>
            Hakuna transactions zilizofanyika bado.
          <% } %>
        </p>
      </div>
    <% } %>

  </main>

  <script>
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');

    function openSidebar() {
      sidebar.classList.add('open');
      overlay.classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      sidebar.classList.remove('open');
      overlay.classList.remove('show');
      document.body.style.overflow = '';
    }

    setTimeout(() => {
      document.querySelectorAll('.toast').forEach((el) => {
        el.style.transition = 'opacity 0.4s, transform 0.4s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(40px)';
        setTimeout(() => el.remove(), 400);
      });
    }, 4000);

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 900) closeSidebar();
    });
  </script>
</body>
</html>
