<!--
  DVARY HOSTING
  FILE: views/bot-details.ejs
  Bot details page - maelezo kamili ya bot + deploy button
-->
<!DOCTYPE html>
<html lang="sw">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    :root {
      --bg: #0a0612;
      --bg-2: #0f0a1f;
      --card: #150d2b;
      --card-2: #1b1138;
      --border: rgba(139, 92, 246, 0.2);
      --border-soft: rgba(139, 92, 246, 0.12);
      --purple: #8b5cf6;
      --purple-2: #a78bfa;
      --pink: #ec4899;
      --cyan: #22d3ee;
      --green: #10b981;
      --red: #ef4444;
      --yellow: #f59e0b;
      --text: #e7e3f5;
      --text-dim: #a59fc2;
      --text-mute: #6f6890;
      --sidebar-w: 250px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 15% 10%, rgba(139, 92, 246, 0.12), transparent 45%),
        radial-gradient(circle at 85% 90%, rgba(236, 72, 153, 0.1), transparent 45%);
      pointer-events: none;
      z-index: 0;
    }

    a { color: inherit; text-decoration: none; }

    /* ============== TOPBAR ============== */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 90;
      backdrop-filter: blur(14px);
      background: rgba(10, 6, 18, 0.85);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      gap: 12px;
    }

    .topbar-left { display: flex; align-items: center; gap: 12px; }

    .menu-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: 0.25s;
      font-size: 1rem;
    }

    .menu-btn:hover {
      border-color: var(--purple);
      background: rgba(139, 92, 246, 0.1);
    }

    .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 0.95rem; }

    .logo-mark {
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 900;
      color: #fff;
      font-size: 1rem;
      box-shadow: 0 0 16px rgba(139, 92, 246, 0.5);
    }

    .logo-text {
      background: linear-gradient(135deg, #fff, var(--purple-2));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: 0.4px;
      display: none;
    }

    .topbar-right { display: flex; align-items: center; gap: 10px; }

    .coins-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 7px 12px;
      border-radius: 999px;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.35);
      color: #fbbf24;
      font-size: 0.83rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .coins-badge small { color: var(--text-mute); font-weight: 500; }

    .avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 800;
      color: #fff;
      font-size: 0.85rem;
      text-transform: uppercase;
      cursor: pointer;
      border: 2px solid rgba(139, 92, 246, 0.4);
    }

    /* ============== SIDEBAR ============== */
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sidebar-w);
      background: linear-gradient(180deg, #0d0820 0%, #100a26 100%);
      border-right: 1px solid var(--border);
      padding: 20px 14px;
      z-index: 200;
      transform: translateX(-100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }

    .sidebar.open { transform: translateX(0); }

    .sidebar-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 8px 20px;
      margin-bottom: 10px;
      border-bottom: 1px solid var(--border-soft);
    }

    .sidebar-logo .logo-mark { width: 36px; height: 36px; font-size: 1.05rem; }
    .sidebar-logo .logo-text { display: block; font-weight: 800; font-size: 0.95rem; }

    .sidebar-nav { display: flex; flex-direction: column; gap: 4px; flex: 1; }

    .nav-section {
      font-size: 0.68rem;
      color: var(--text-mute);
      text-transform: uppercase;
      letter-spacing: 1.2px;
      padding: 14px 10px 6px;
      font-weight: 700;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 11px 12px;
      border-radius: 10px;
      color: var(--text-dim);
      font-size: 0.88rem;
      font-weight: 500;
      transition: 0.2s;
      position: relative;
    }

    .sidebar-link .icon { width: 20px; text-align: center; font-size: 1.05rem; }
    .sidebar-link:hover { background: rgba(139, 92, 246, 0.1); color: var(--purple-2); }

    .sidebar-link.active {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.22), rgba(236, 72, 153, 0.15));
      color: #fff;
      border: 1px solid rgba(139, 92, 246, 0.35);
      box-shadow: 0 4px 18px rgba(139, 92, 246, 0.2);
    }

    .sidebar-link.active::before {
      content: '';
      position: absolute;
      left: -14px;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 22px;
      background: linear-gradient(180deg, var(--purple), var(--pink));
      border-radius: 0 3px 3px 0;
    }

    .sidebar-footer { border-top: 1px solid var(--border-soft); padding-top: 10px; margin-top: 10px; }
    .sidebar-footer .sidebar-link { color: #f87171; }
    .sidebar-footer .sidebar-link:hover { background: rgba(239, 68, 68, 0.1); color: #fca5a5; }

    /* ============== OVERLAY ============== */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(3px);
      z-index: 150;
      opacity: 0;
      visibility: hidden;
      transition: 0.3s;
    }

    .overlay.show { opacity: 1; visibility: visible; }

    /* ============== MAIN ============== */
    .main {
      position: relative;
      z-index: 1;
      padding: 20px 16px 40px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .breadcrumbs {
      font-size: 0.82rem;
      color: var(--text-mute);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .breadcrumbs a { color: var(--text-dim); transition: 0.2s; }
    .breadcrumbs a:hover { color: var(--purple-2); }
    .breadcrumbs .sep { color: var(--text-mute); }
    .breadcrumbs .current { color: var(--purple-2); font-weight: 600; }

    /* ============== HERO ============== */
    .hero-card {
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px solid var(--border);
      border-radius: 20px;
      overflow: hidden;
      margin-bottom: 20px;
      position: relative;
    }

    .hero-banner {
      height: 200px;
      background: linear-gradient(135deg, #1a0f38, #2a1560);
      display: grid;
      place-items: center;
      font-size: 4rem;
      color: var(--purple-2);
      position: relative;
      overflow: hidden;
    }

    .hero-banner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-featured {
      position: absolute;
      top: 14px;
      right: 14px;
      padding: 6px 14px;
      border-radius: 999px;
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      color: #1a0f38;
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.45);
    }

    .hero-body { padding: 20px 18px; }

    .hero-cat {
      display: inline-block;
      font-size: 0.72rem;
      padding: 4px 12px;
      border-radius: 999px;
      background: rgba(139, 92, 246, 0.15);
      color: var(--purple-2);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 10px;
    }

    .hero-body h1 {
      font-size: clamp(1.35rem, 4vw, 1.9rem);
      font-weight: 800;
      margin-bottom: 10px;
      letter-spacing: -0.3px;
    }

    .hero-body .short-desc {
      color: var(--text-dim);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 16px;
    }

    /* ============== SPECS GRID ============== */
    .specs {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-bottom: 18px;
    }

    .spec-box {
      background: rgba(139, 92, 246, 0.06);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      padding: 12px 14px;
      transition: 0.25s;
    }

    .spec-box:hover {
      border-color: rgba(139, 92, 246, 0.35);
      background: rgba(139, 92, 246, 0.1);
    }

    .spec-box .label {
      font-size: 0.7rem;
      color: var(--text-mute);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .spec-box .value {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text);
    }

    .spec-box.gold .value {
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    /* ============== ACTION BAR ============== */
    .action-bar {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 16px;
      background: rgba(139, 92, 246, 0.06);
      border: 1px solid var(--border-soft);
      border-radius: 14px;
      margin-top: 6px;
    }

    .price-display {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .price-label { font-size: 0.82rem; color: var(--text-dim); font-weight: 600; }
    .price-value {
      font-size: 1.4rem;
      font-weight: 800;
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .price-value small {
      color: var(--text-mute);
      font-weight: 500;
      font-size: 0.78rem;
      -webkit-text-fill-color: var(--text-mute);
    }

    .balance-info {
      font-size: 0.8rem;
      color: var(--text-mute);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .balance-info.insufficient { color: #f87171; }
    .balance-info.ok { color: #34d399; }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 13px 20px;
      border-radius: 11px;
      font-weight: 700;
      font-size: 0.92rem;
      border: none;
      cursor: pointer;
      transition: 0.25s;
      font-family: inherit;
      text-decoration: none;
      width: 100%;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--purple), var(--pink));
      color: #fff;
      box-shadow: 0 6px 22px rgba(139, 92, 246, 0.4);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(139, 92, 246, 0.55);
    }

    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .btn-ghost {
      background: transparent;
      color: var(--text-dim);
      border: 1px solid var(--border);
    }

    .btn-ghost:hover {
      color: var(--purple-2);
      border-color: var(--purple);
      background: rgba(139, 92, 246, 0.1);
    }

    /* ============== SECTIONS ============== */
    .section-card {
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 18px;
      margin-bottom: 18px;
    }

    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-soft);
    }

    .section-head h2 {
      font-size: 1rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-head h2 .icon { font-size: 1.1rem; }

    .section-head a {
      font-size: 0.82rem;
      color: var(--purple-2);
      font-weight: 600;
    }

    .section-head a:hover { color: var(--pink); }

    .description {
      color: var(--text-dim);
      font-size: 0.9rem;
      line-height: 1.7;
      white-space: pre-wrap;
      word-wrap: break-word;
    }

    /* ============== TAGS ============== */
    .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }

    .tag {
      font-size: 0.75rem;
      padding: 5px 12px;
      border-radius: 999px;
      background: rgba(34, 211, 238, 0.08);
      color: #67e8f9;
      border: 1px solid rgba(34, 211, 238, 0.22);
      font-weight: 600;
    }

    /* ============== GITHUB INFO ============== */
    .github-info {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 14px;
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid var(--border-soft);
      border-radius: 10px;
      font-family: 'Courier New', monospace;
      font-size: 0.85rem;
      color: var(--text-dim);
      word-break: break-all;
    }

    .github-info .icon { flex-shrink: 0; }

    /* ============== DEPLOYMENTS LIST ============== */
    .list { display: flex; flex-direction: column; gap: 10px; }

    .list-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px;
      border-radius: 12px;
      background: rgba(139, 92, 246, 0.04);
      border: 1px solid var(--border-soft);
      transition: 0.25s;
    }

    .list-item:hover {
      background: rgba(139, 92, 246, 0.1);
      border-color: rgba(139, 92, 246, 0.3);
      transform: translateX(3px);
    }

    .list-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(236, 72, 153, 0.15));
      display: grid;
      place-items: center;
      font-size: 1rem;
      flex-shrink: 0;
    }

    .list-body { flex: 1; min-width: 0; }

    .list-title {
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 3px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .list-sub { font-size: 0.76rem; color: var(--text-mute); }

    .list-meta { text-align: right; flex-shrink: 0; }

    .badge {
      display: inline-block;
      font-size: 0.68rem;
      padding: 3px 9px;
      border-radius: 999px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      white-space: nowrap;
    }

    .badge-success { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
    .badge-pending { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
    .badge-failed  { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
    .badge-neutral { background: rgba(139, 92, 246, 0.15); color: var(--purple-2); border: 1px solid rgba(139, 92, 246, 0.3); }

    /* ============== RELATED BOTS ============== */
    .related-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .related-card {
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      transition: 0.25s;
    }

    .related-card:hover {
      transform: translateY(-4px);
      border-color: rgba(139, 92, 246, 0.5);
      box-shadow: 0 8px 22px rgba(139, 92, 246, 0.2);
    }

    .related-img {
      height: 90px;
      background: linear-gradient(135deg, #1a0f38, #2a1560);
      display: grid;
      place-items: center;
      font-size: 1.8rem;
      color: var(--purple-2);
      overflow: hidden;
    }

    .related-img img { width: 100%; height: 100%; object-fit: cover; }

    .related-body { padding: 10px 12px; }
    .related-name {
      font-size: 0.85rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-bottom: 4px;
    }
    .related-price {
      font-size: 0.78rem;
      font-weight: 700;
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .empty-mini {
      text-align: center;
      padding: 20px 12px;
      color: var(--text-mute);
      font-size: 0.85rem;
    }

    /* ============== TOASTS ============== */
    .toast-container {
      position: fixed;
      top: 74px;
      right: 14px;
      z-index: 999;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 340px;
      width: calc(100% - 28px);
    }

    .toast {
      padding: 12px 15px;
      border-radius: 12px;
      background: var(--card-2);
      border-left: 4px solid var(--purple);
      color: var(--text);
      font-size: 0.85rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      animation: slideIn 0.35s ease;
    }

    .toast.success { border-left-color: var(--green); }
    .toast.error { border-left-color: var(--red); }
    .toast.warning { border-left-color: var(--yellow); }

    @keyframes slideIn {
      from { opacity: 0; transform: translateX(40px); }
      to { opacity: 1; transform: translateX(0); }
    }

    /* ============== RESPONSIVE ============== */
    @media (min-width: 480px) {
      .logo-text { display: block; }
      .specs { grid-template-columns: repeat(4, 1fr); }
      .related-grid { grid-template-columns: repeat(3, 1fr); }
    }

    @media (min-width: 700px) {
      .action-bar { flex-direction: row; align-items: center; justify-content: space-between; }
      .action-bar .btn { width: auto; min-width: 200px; }
      .hero-banner { height: 260px; font-size: 5rem; }
    }

    @media (min-width: 900px) {
      .topbar { padding-left: calc(var(--sidebar-w) + 20px); }
      .sidebar { transform: translateX(0); }
      .menu-btn { display: none; }
      .main { padding: 26px 30px 60px; margin-left: var(--sidebar-w); max-width: none; }
      .overlay { display: none; }
      .related-grid { grid-template-columns: repeat(4, 1fr); }
    }
  </style>
</head>
<body>

  <!-- ============== TOASTS ============== -->
  <% if (success && success.length > 0) { %>
    <div class="toast-container">
      <% success.forEach((msg) => { %>
        <div class="toast success"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="toast-container">
      <% error.forEach((msg) => { %>
        <div class="toast error"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (warning && warning.length > 0) { %>
    <div class="toast-container">
      <% warning.forEach((msg) => { %>
        <div class="toast warning"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>

  <!-- ============== OVERLAY ============== -->
  <div class="overlay" id="overlay" onclick="closeSidebar()"></div>

  <!-- ============== SIDEBAR ============== -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-mark">D</div>
      <div class="logo-text">DVARY HOSTING</div>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section">Menu</div>

      <a href="/dashboard" class="sidebar-link">
        <span class="icon">🏠</span> Dashboard
      </a>
      <a href="/bots" class="sidebar-link active">
        <span class="icon">🤖</span> Deploy Bots
      </a>
      <a href="/deploy" class="sidebar-link">
        <span class="icon">🚀</span> My Deployments
      </a>
      <a href="/servers/buy" class="sidebar-link">
        <span class="icon">🛒</span> Buy Server
      </a>
      <a href="/servers" class="sidebar-link">
        <span class="icon">🖥️</span> My Servers
      </a>
      <a href="/servers/admin-panels" class="sidebar-link">
        <span class="icon">🛡️</span> Admin Panels
      </a>
      <a href="/servers/my-panels" class="sidebar-link">
        <span class="icon">📦</span> My Panels
      </a>

      <div class="nav-section">Akaunti</div>

      <a href="/coins" class="sidebar-link">
        <span class="icon">🪙</span> Coins
      </a>
      <a href="/coins/transactions" class="sidebar-link">
        <span class="icon">📊</span> Transactions
      </a>
      <a href="/dashboard/profile" class="sidebar-link">
        <span class="icon">👤</span> Profile
      </a>
      <a href="/dashboard/settings" class="sidebar-link">
        <span class="icon">⚙️</span> Settings
      </a>
    </nav>

    <div class="sidebar-footer">
      <% if (isAdmin) { %>
        <a href="/admin/dashboard" class="sidebar-link">
          <span class="icon">🔑</span> Admin Panel
        </a>
      <% } %>
      <a href="/auth/logout" class="sidebar-link">
        <span class="icon">🚪</span> Logout
      </a>
    </div>
  </aside>

  <!-- ============== TOPBAR ============== -->
  <header class="topbar">
    <div class="topbar-left">
      <button class="menu-btn" onclick="openSidebar()" aria-label="Menu">☰</button>
      <div class="logo">
        <div class="logo-mark">D</div>
        <span class="logo-text">DVARY HOSTING</span>
      </div>
    </div>

    <div class="topbar-right">
      <a href="/coins" class="coins-badge">
        🪙 <%= user.coins %> <small>coins</small>
      </a>
      <a href="/dashboard/profile" class="avatar" title="<%= user.username %>">
        <%= user.username.charAt(0) %>
      </a>
    </div>
  </header>

  <!-- ============== MAIN ============== -->
  <main class="main">

    <!-- BREADCRUMBS -->
    <div class="breadcrumbs">
      <a href="/dashboard">Dashboard</a>
      <span class="sep">/</span>
      <a href="/bots">Bots</a>
      <span class="sep">/</span>
      <span class="current"><%= bot.name %></span>
    </div>

    <!-- HERO CARD -->
    <div class="hero-card">
      <div class="hero-banner">
        <% if (bot.image) { %>
          <img src="<%= bot.image %>" alt="<%= bot.name %>" />
        <% } else { %>
          🤖
        <% } %>
        <% if (bot.featured) { %>
          <div class="hero-featured">⭐ Featured</div>
        <% } %>
      </div>

      <div class="hero-body">
        <span class="hero-cat"><%= bot.category %></span>
        <h1><%= bot.name %></h1>
        <p class="short-desc"><%= bot.shortDescription || bot.description %></p>

        <!-- SPECS -->
        <div class="specs">
          <div class="spec-box gold">
            <div class="label">Bei</div>
            <div class="value"><%= bot.price %></div>
          </div>
          <div class="spec-box">
            <div class="label">RAM</div>
            <div class="value"><%= bot.ram %> MB</div>
          </div>
          <div class="spec-box">
            <div class="label">CPU</div>
            <div class="value"><%= bot.cpu %>%</div>
          </div>
          <div class="spec-box">
            <div class="label">Disk</div>
            <div class="value"><%= bot.disk %> MB</div>
          </div>
        </div>

        <!-- ACTION BAR -->
        <div class="action-bar">
          <div>
            <div class="price-display">
              <span class="price-label">Bei ya Deployment</span>
              <span class="price-value"><%= bot.price %> <small>coins</small></span>
            </div>
            <div class="balance-info <%= user.coins >= bot.price ? 'ok' : 'insufficient' %>">
              <span><%= user.coins >= bot.price ? '✅' : '⚠️' %></span>
              <span>Balance yako: <strong><%= user.coins %> coins</strong></span>
            </div>
          </div>

          <% if (user.coins >= bot.price) { %>
            <form action="/deploy" method="POST" style="width: 100%;">
              <input type="hidden" name="botId" value="<%= bot._id %>" />
              <button type="submit" class="btn btn-primary">
                🚀 Deploy Sasa
              </button>
            </form>
          <% } else { %>
            <button class="btn btn-primary" disabled>
              Coins Hazitoshi
            </button>
          <% } %>
        </div>
      </div>
    </div>

    <!-- FULL DESCRIPTION -->
    <div class="section-card">
      <div class="section-head">
        <h2><span class="icon">📝</span> Maelezo Kamili</h2>
      </div>
      <div class="description"><%= bot.description %></div>

      <% if (bot.tags && bot.tags.length > 0) { %>
        <div class="tags">
          <% bot.tags.forEach((tag) => { %>
            <span class="tag">#<%= tag %></span>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- GITHUB INFO -->
    <div class="section-card">
      <div class="section-head">
        <h2><span class="icon">🐙</span> GitHub Repository</h2>
      </div>

      <div class="github-info">
        <span class="icon">🔗</span>
        <span><%= bot.githubUrl %></span>
      </div>

      <% if (bot.githubBranch) { %>
        <div class="github-info" style="margin-top: 10px;">
          <span class="icon">🌿</span>
          <span>Branch: <strong><%= bot.githubBranch %></strong></span>
        </div>
      <% } %>
    </div>

    <!-- MY DEPLOYMENTS KWA BOT HII -->
    <% if (myDeployments && myDeployments.length > 0) { %>
      <div class="section-card">
        <div class="section-head">
          <h2><span class="icon">📜</span> Deployments Zako za Bot Hii</h2>
          <a href="/deploy">Ona zote →</a>
        </div>

        <div class="list">
          <% myDeployments.forEach((d) => { %>
            <a href="/deploy/status/<%= d._id %>" class="list-item">
              <div class="list-icon">🚀</div>
              <div class="list-body">
                <div class="list-title">Deployment #<%= d._id.toString().slice(-6) %></div>
                <div class="list-sub">
                  <%= new Date(d.createdAt).toLocaleString('sw-TZ', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                  • <%= d.coinsSpent %> coins
                </div>
              </div>
              <div class="list-meta">
                <% if (d.status === 'success') { %>
                  <span class="badge badge-success">Success</span>
                <% } else if (d.status === 'failed') { %>
                  <span class="badge badge-failed">Failed</span>
                <% } else if (d.status === 'cancelled') { %>
                  <span class="badge badge-neutral">Cancelled</span>
                <% } else { %>
                  <span class="badge badge-pending"><%= d.status %></span>
                <% } %>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- RELATED BOTS -->
    <% if (relatedBots && relatedBots.length > 0) { %>
      <div class="section-card">
        <div class="section-head">
          <h2><span class="icon">🤝</span> Bots Zinazofanana</h2>
          <a href="/bots?category=<%= bot.category %>">Ona zote →</a>
        </div>

        <div class="related-grid">
          <% relatedBots.forEach((rb) => { %>
            <a href="/bots/<%= rb._id %>" class="related-card">
              <div class="related-img">
                <% if (rb.image) { %>
                  <img src="<%= rb.image %>" alt="<%= rb.name %>" loading="lazy" />
                <% } else { %>
                  🤖
                <% } %>
              </div>
              <div class="related-body">
                <div class="related-name"><%= rb.name %></div>
                <div class="related-price"><%= rb.price %> coins</div>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>

  </main>

  <script>
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');

    function openSidebar() {
      sidebar.classList.add('open');
      overlay.classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      sidebar.classList.remove('open');
      overlay.classList.remove('show');
      document.body.style.overflow = '';
    }

    setTimeout(() => {
      document.querySelectorAll('.toast').forEach((el) => {
        el.style.transition = 'opacity 0.4s, transform 0.4s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(40px)';
        setTimeout(() => el.remove(), 400);
      });
    }, 4000);

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 900) closeSidebar();
    });
  </script>
</body>
</html>
