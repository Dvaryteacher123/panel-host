<!DOCTYPE html>
<html lang="sw">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    :root {
      --bg: #0a0612;
      --bg-2: #0f0a1f;
      --card: #150d2b;
      --card-2: #1b1138;
      --border: rgba(139, 92, 246, 0.2);
      --border-soft: rgba(139, 92, 246, 0.12);
      --purple: #8b5cf6;
      --purple-2: #a78bfa;
      --pink: #ec4899;
      --cyan: #22d3ee;
      --green: #10b981;
      --red: #ef4444;
      --yellow: #f59e0b;
      --text: #e7e3f5;
      --text-dim: #a59fc2;
      --text-mute: #6f6890;
      --sidebar-w: 250px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 15% 10%, rgba(139, 92, 246, 0.12), transparent 45%),
        radial-gradient(circle at 85% 90%, rgba(236, 72, 153, 0.1), transparent 45%);
      pointer-events: none;
      z-index: 0;
    }

    a { color: inherit; text-decoration: none; }

    /* ============== TOPBAR ============== */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 90;
      backdrop-filter: blur(14px);
      background: rgba(10, 6, 18, 0.85);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      gap: 12px;
    }

    .topbar-left { display: flex; align-items: center; gap: 12px; }

    .menu-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: 0.25s;
      font-size: 1rem;
    }

    .menu-btn:hover {
      border-color: var(--purple);
      background: rgba(139, 92, 246, 0.1);
    }

    .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 0.95rem; }

    .logo-mark {
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 900;
      color: #fff;
      font-size: 1rem;
      box-shadow: 0 0 16px rgba(139, 92, 246, 0.5);
    }

    .logo-text {
      background: linear-gradient(135deg, #fff, var(--purple-2));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: 0.4px;
      display: none;
    }

    .topbar-right { display: flex; align-items: center; gap: 10px; }

    .coins-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 7px 12px;
      border-radius: 999px;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.35);
      color: #fbbf24;
      font-size: 0.83rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .coins-badge small { color: var(--text-mute); font-weight: 500; }

    .avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 800;
      color: #fff;
      font-size: 0.85rem;
      text-transform: uppercase;
      cursor: pointer;
      border: 2px solid rgba(139, 92, 246, 0.4);
    }

    /* ============== SIDEBAR ============== */
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sidebar-w);
      background: linear-gradient(180deg, #0d0820 0%, #100a26 100%);
      border-right: 1px solid var(--border);
      padding: 20px 14px;
      z-index: 200;
      transform: translateX(-100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }

    .sidebar.open { transform: translateX(0); }

    .sidebar-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 8px 20px;
      margin-bottom: 10px;
      border-bottom: 1px solid var(--border-soft);
    }

    .sidebar-logo .logo-mark { width: 36px; height: 36px; font-size: 1.05rem; }
    .sidebar-logo .logo-text { display: block; font-weight: 800; font-size: 0.95rem; }

    .sidebar-nav { display: flex; flex-direction: column; gap: 4px; flex: 1; }

    .nav-section {
      font-size: 0.68rem;
      color: var(--text-mute);
      text-transform: uppercase;
      letter-spacing: 1.2px;
      padding: 14px 10px 6px;
      font-weight: 700;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 11px 12px;
      border-radius: 10px;
      color: var(--text-dim);
      font-size: 0.88rem;
      font-weight: 500;
      transition: 0.2s;
      position: relative;
    }

    .sidebar-link .icon { width: 20px; text-align: center; font-size: 1.05rem; }
    .sidebar-link:hover { background: rgba(139, 92, 246, 0.1); color: var(--purple-2); }

    .sidebar-link.active {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.22), rgba(236, 72, 153, 0.15));
      color: #fff;
      border: 1px solid rgba(139, 92, 246, 0.35);
      box-shadow: 0 4px 18px rgba(139, 92, 246, 0.2);
    }

    .sidebar-link.active::before {
      content: '';
      position: absolute;
      left: -14px;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 22px;
      background: linear-gradient(180deg, var(--purple), var(--pink));
      border-radius: 0 3px 3px 0;
    }

    .sidebar-footer { border-top: 1px solid var(--border-soft); padding-top: 10px; margin-top: 10px; }
    .sidebar-footer .sidebar-link { color: #f87171; }
    .sidebar-footer .sidebar-link:hover { background: rgba(239, 68, 68, 0.1); color: #fca5a5; }

    /* ============== OVERLAY ============== */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(3px);
      z-index: 150;
      opacity: 0;
      visibility: hidden;
      transition: 0.3s;
    }

    .overlay.show { opacity: 1; visibility: visible; }

    /* ============== MAIN ============== */
    .main {
      position: relative;
      z-index: 1;
      padding: 20px 16px 40px;
      max-width: 800px;
      margin: 0 auto;
    }

    .page-head { margin-bottom: 22px; }

    .page-head h1 {
      font-size: clamp(1.3rem, 4vw, 1.75rem);
      font-weight: 800;
      margin-bottom: 6px;
      letter-spacing: -0.3px;
    }

    .page-head h1 span {
      background: linear-gradient(135deg, var(--purple-2), var(--pink));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .page-head p { color: var(--text-dim); font-size: 0.9rem; }

    /* ============== SECTION ============== */
    .section-card {
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 18px;
    }

    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-soft);
      flex-wrap: wrap;
    }

    .section-head h2 {
      font-size: 1rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-head h2 .icon { font-size: 1.1rem; }

    .section-desc {
      font-size: 0.83rem;
      color: var(--text-dim);
      margin-bottom: 16px;
      line-height: 1.6;
    }

    /* ============== FORM ============== */
    .form-group { margin-bottom: 16px; }

    .form-group label {
      display: block;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-dim);
      margin-bottom: 7px;
      letter-spacing: 0.3px;
    }

    .input-wrap { position: relative; }

    .input {
      width: 100%;
      padding: 12px 44px 12px 14px;
      border-radius: 10px;
      background: rgba(10, 6, 18, 0.6);
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 0.92rem;
      font-family: inherit;
      transition: 0.25s;
      outline: none;
    }

    .input:focus {
      border-color: var(--purple);
      box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
      background: rgba(10, 6, 18, 0.85);
    }

    .input::placeholder { color: var(--text-mute); }

    .toggle {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: var(--text-mute);
      cursor: pointer;
      font-size: 0.75rem;
      padding: 4px 6px;
      font-weight: 700;
      letter-spacing: 0.3px;
      font-family: inherit;
    }

    .toggle:hover { color: var(--purple-2); }

    /* ============== STRENGTH ============== */
    .strength {
      height: 4px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.06);
      margin-top: 8px;
      overflow: hidden;
    }

    .strength-bar {
      height: 100%;
      width: 0%;
      border-radius: 999px;
      background: var(--red);
      transition: all 0.35s;
    }

    .strength-bar.weak { width: 33%; background: var(--red); }
    .strength-bar.medium { width: 66%; background: #f59e0b; }
    .strength-bar.strong { width: 100%; background: var(--green); }

    .strength-text {
      font-size: 0.72rem;
      color: var(--text-mute);
      margin-top: 5px;
      letter-spacing: 0.3px;
    }

    /* ============== BUTTONS ============== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 20px;
      border-radius: 11px;
      font-weight: 700;
      font-size: 0.9rem;
      border: none;
      cursor: pointer;
      transition: 0.25s;
      font-family: inherit;
      text-decoration: none;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--purple), var(--pink));
      color: #fff;
      box-shadow: 0 6px 22px rgba(139, 92, 246, 0.4);
    }

    .btn-primary:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(139, 92, 246, 0.55);
    }

    .btn-primary:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .btn-danger {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.35);
      width: 100%;
    }

    .btn-danger:hover {
      background: rgba(239, 68, 68, 0.25);
      color: #fca5a5;
    }

    .btn-ghost {
      background: transparent;
      color: var(--text-dim);
      border: 1px solid var(--border);
    }

    .btn-ghost:hover {
      color: var(--purple-2);
      border-color: var(--purple);
      background: rgba(139, 92, 246, 0.1);
    }

    /* ============== INFO ROW ============== */
    .info-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 14px;
      background: rgba(139, 92, 246, 0.05);
      border: 1px solid var(--border-soft);
      border-radius: 10px;
      font-size: 0.87rem;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }

    .info-row:last-child { margin-bottom: 0; }

    .info-row .lbl {
      color: var(--text-mute);
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .info-row .vl {
      color: var(--text);
      font-weight: 700;
      text-align: right;
      word-break: break-all;
      flex: 1;
      min-width: 0;
    }

    /* ============== DANGER ZONE ============== */
    .danger-zone {
      background: linear-gradient(160deg, rgba(239, 68, 68, 0.08), rgba(245, 158, 11, 0.05));
      border: 1px solid rgba(239, 68, 68, 0.25);
      border-radius: 14px;
      padding: 18px;
      margin-top: 10px;
    }

    .danger-zone h3 {
      font-size: 0.92rem;
      font-weight: 700;
      color: #f87171;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .danger-zone p {
      font-size: 0.83rem;
      color: var(--text-dim);
      line-height: 1.6;
      margin-bottom: 14px;
    }

    /* ============== TOASTS ============== */
    .toast-container {
      position: fixed;
      top: 74px;
      right: 14px;
      z-index: 999;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 340px;
      width: calc(100% - 28px);
    }

    .toast {
      padding: 12px 15px;
      border-radius: 12px;
      background: var(--card-2);
      border-left: 4px solid var(--purple);
      color: var(--text);
      font-size: 0.85rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      animation: slideIn 0.35s ease;
    }

    .toast.success { border-left-color: var(--green); }
    .toast.error { border-left-color: var(--red); }
    .toast.warning { border-left-color: var(--yellow); }

    @keyframes slideIn {
      from { opacity: 0; transform: translateX(40px); }
      to { opacity: 1; transform: translateX(0); }
    }

    /* ============== LOADING ============== */
    .spinner {
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      display: none;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .btn-primary.loading .spinner { display: inline-block; }
    .btn-primary.loading .btn-text { display: none; }

    /* ============== RESPONSIVE ============== */
    @media (min-width: 480px) {
      .logo-text { display: block; }
    }

    @media (min-width: 900px) {
      .topbar { padding-left: calc(var(--sidebar-w) + 20px); }
      .sidebar { transform: translateX(0); }
      .menu-btn { display: none; }
      .main { padding: 26px 30px 60px; margin-left: var(--sidebar-w); max-width: none; }
      .overlay { display: none; }
    }
  </style>
</head>
<body>

  <!-- ============== TOASTS ============== -->
  <% if (success && success.length > 0) { %>
    <div class="toast-container">
      <% success.forEach((msg) => { %>
        <div class="toast success"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="toast-container">
      <% error.forEach((msg) => { %>
        <div class="toast error"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (warning && warning.length > 0) { %>
    <div class="toast-container">
      <% warning.forEach((msg) => { %>
        <div class="toast warning"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>

  <!-- ============== OVERLAY ============== -->
  <div class="overlay" id="overlay" onclick="closeSidebar()"></div>

  <!-- ============== SIDEBAR ============== -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-mark">D</div>
      <div class="logo-text">DVARY HOSTING</div>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section">Menu</div>

      <a href="/dashboard" class="sidebar-link">
        <span class="icon">🏠</span> Dashboard
      </a>
      <a href="/bots" class="sidebar-link">
        <span class="icon">🤖</span> Deploy Bots
      </a>
      <a href="/deploy" class="sidebar-link">
        <span class="icon">🚀</span> My Deployments
      </a>
      <a href="/servers/buy" class="sidebar-link">
        <span class="icon">🛒</span> Buy Server
      </a>
      <a href="/servers" class="sidebar-link">
        <span class="icon">🖥️</span> My Servers
      </a>
      <a href="/servers/admin-panels" class="sidebar-link">
        <span class="icon">🛡️</span> Admin Panels
      </a>
      <a href="/servers/my-panels" class="sidebar-link">
        <span class="icon">📦</span> My Panels
      </a>

      <div class="nav-section">Akaunti</div>

      <a href="/coins" class="sidebar-link">
        <span class="icon">🪙</span> Coins
      </a>
      <a href="/coins/transactions" class="sidebar-link">
        <span class="icon">📊</span> Transactions
      </a>
      <a href="/dashboard/profile" class="sidebar-link">
        <span class="icon">👤</span> Profile
      </a>
      <a href="/dashboard/settings" class="sidebar-link active">
        <span class="icon">⚙️</span> Settings
      </a>
    </nav>

    <div class="sidebar-footer">
      <% if (isAdmin) { %>
        <a href="/admin/dashboard" class="sidebar-link">
          <span class="icon">🔑</span> Admin Panel
        </a>
      <% } %>
      <a href="/auth/logout" class="sidebar-link">
        <span class="icon">🚪</span> Logout
      </a>
    </div>
  </aside>

  <!-- ============== TOPBAR ============== -->
  <header class="topbar">
    <div class="topbar-left">
      <button class="menu-btn" onclick="openSidebar()" aria-label="Menu">☰</button>
      <div class="logo">
        <div class="logo-mark">D</div>
        <span class="logo-text">DVARY HOSTING</span>
      </div>
    </div>

    <div class="topbar-right">
      <a href="/coins" class="coins-badge">
        🪙 <%= user.coins %> <small>coins</small>
      </a>
      <a href="/dashboard/profile" class="avatar" title="<%= user.username %>">
        <%= user.username.charAt(0) %>
      </a>
    </div>
  </header>

  <!-- ============== MAIN ============== -->
  <main class="main">

    <div class="page-head">
      <h1>Settings <span>& Usalama</span> ⚙️</h1>
      <p>Badilisha password yako na simamia usalama wa akaunti.</p>
    </div>

    <!-- ACCOUNT SUMMARY -->
    <div class="section-card">
      <div class="section-head">
        <h2><span class="icon">👤</span> Muhtasari wa Akaunti</h2>
      </div>

      <div class="info-row">
        <span class="lbl">👤 Username</span>
        <span class="vl"><%= user.username %></span>
      </div>
      <div class="info-row">
        <span class="lbl">📧 Email</span>
        <span class="vl"><%= user.email %></span>
      </div>
      <div class="info-row">
        <span class="lbl">🪙 Balance</span>
        <span class="vl"><%= user.coins %> coins</span>
      </div>
      <div class="info-row">
        <span class="lbl">🎭 Role</span>
        <span class="vl" style="text-transform: capitalize;"><%= user.role %></span>
      </div>
    </div>

    <!-- CHANGE PASSWORD -->
    <div class="section-card">
      <div class="section-head">
        <h2><span class="icon">🔒</span> Badilisha Password</h2>
      </div>

      <p class="section-desc">
        Kwa usalama wako, tumia password imara yenye herufi kubwa, ndogo, namba na alama.
        Password iwe angalau herufi 8.
      </p>

      <form action="/dashboard/settings/password" method="POST" id="passwordForm">
        <div class="form-group">
          <label for="currentPassword">Password ya Sasa</label>
          <div class="input-wrap">
            <input
              type="password"
              id="currentPassword"
              name="currentPassword"
              class="input"
              placeholder="••••••••"
              required
            />
            <button type="button" class="toggle" onclick="togglePassword('currentPassword', this)">Onyesha</button>
          </div>
        </div>

        <div class="form-group">
          <label for="newPassword">Password Mpya</label>
          <div class="input-wrap">
            <input
              type="password"
              id="newPassword"
              name="newPassword"
              class="input"
              placeholder="••••••••"
              required
              minlength="8"
              oninput="checkStrength(this.value)"
            />
            <button type="button" class="toggle" onclick="togglePassword('newPassword', this)">Onyesha</button>
          </div>
          <div class="strength">
            <div class="strength-bar" id="strengthBar"></div>
          </div>
          <div class="strength-text" id="strengthText">Angalau herufi 8</div>
        </div>

        <div class="form-group">
          <label for="confirmPassword">Rudia Password Mpya</label>
          <div class="input-wrap">
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              class="input"
              placeholder="••••••••"
              required
              minlength="8"
            />
            <button type="button" class="toggle" onclick="togglePassword('confirmPassword', this)">Onyesha</button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary" id="submitBtn">
          <span class="btn-text">🔒 Badilisha Password</span>
          <span class="spinner"></span>
        </button>
      </form>
    </div>

    <!-- SECURITY TIPS -->
    <div class="section-card">
      <div class="section-head">
        <h2><span class="icon">💡</span> Vidokezo vya Usalama</h2>
      </div>

      <div class="info-row">
        <span class="lbl">✅</span>
        <span class="vl" style="text-align: left; font-weight: 500;">
          Usishiriki password yako na mtu yeyote — hata admin.
        </span>
      </div>
      <div class="info-row">
        <span class="lbl">✅</span>
        <span class="vl" style="text-align: left; font-weight: 500;">
          Tumia password tofauti kwa kila akaunti.
        </span>
      </div>
      <div class="info-row">
        <span class="lbl">✅</span>
        <span class="vl" style="text-align: left; font-weight: 500;">
          Badilisha password mara kwa mara kwa usalama zaidi.
        </span>
      </div>
      <div class="info-row">
        <span class="lbl">✅</span>
        <span class="vl" style="text-align: left; font-weight: 500;">
          Toka (logout) kama unatumia kompyuta ya umma.
        </span>
      </div>
    </div>

    <!-- DANGER / LOGOUT -->
    <div class="danger-zone">
      <h3>⚠️ Kikao cha Sasa</h3>
      <p>
        Ukibonyeza "Logout" utatolewa kwenye akaunti yako. Utahitaji kuingia tena kwa email na password.
      </p>
      <a href="/auth/logout" class="btn btn-danger">🚪 Logout Kutoka Akaunti</a>
    </div>

  </main>

  <script>
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');

    function openSidebar() {
      sidebar.classList.add('open');
      overlay.classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      sidebar.classList.remove('open');
      overlay.classList.remove('show');
      document.body.style.overflow = '';
    }

    function togglePassword(id, btn) {
      const input = document.getElementById(id);
      if (input.type === 'password') {
        input.type = 'text';
        btn.textContent = 'Ficha';
      } else {
        input.type = 'password';
        btn.textContent = 'Onyesha';
      }
    }

    function checkStrength(value) {
      const bar = document.getElementById('strengthBar');
      const text = document.getElementById('strengthText');
      const score = getScore(value);

      bar.className = 'strength-bar';
      if (value.length === 0) {
        text.textContent = 'Angalau herufi 8';
        return;
      }

      if (score <= 2) {
        bar.classList.add('weak');
        text.textContent = 'Dhaifu';
      } else if (score === 3 || score === 4) {
        bar.classList.add('medium');
        text.textContent = 'Wastani';
      } else {
        bar.classList.add('strong');
        text.textContent = 'Imara';
      }
    }

    function getScore(pwd) {
      let score = 0;
      if (pwd.length >= 8) score++;
      if (pwd.length >= 12) score++;
      if (/[A-Z]/.test(pwd)) score++;
      if (/[0-9]/.test(pwd)) score++;
      if (/[^A-Za-z0-9]/.test(pwd)) score++;
      return score;
    }

    document.getElementById('passwordForm').addEventListener('submit', function (e) {
      const newPwd = document.getElementById('newPassword').value;
      const confirm = document.getElementById('confirmPassword').value;

      if (newPwd !== confirm) {
        e.preventDefault();
        alert('Password mpya na confirm hazifanani.');
        return;
      }

      const btn = document.getElementById('submitBtn');
      btn.classList.add('loading');
      btn.disabled = true;
    });

    setTimeout(() => {
      document.querySelectorAll('.toast').forEach((el) => {
        el.style.transition = 'opacity 0.4s, transform 0.4s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(40px)';
        setTimeout(() => el.remove(), 400);
      });
    }, 4000);

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 900) closeSidebar();
    });
  </script>
</body>
</html>
