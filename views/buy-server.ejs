<!--
  DVARY HOSTING
  FILE: views/buy-server.ejs
  Buy Server - Hosting plans marketplace (user view)
-->
<!DOCTYPE html>
<html lang="sw">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    :root {
      --bg: #0a0612;
      --bg-2: #0f0a1f;
      --card: #150d2b;
      --card-2: #1b1138;
      --border: rgba(139, 92, 246, 0.2);
      --border-soft: rgba(139, 92, 246, 0.12);
      --purple: #8b5cf6;
      --purple-2: #a78bfa;
      --pink: #ec4899;
      --cyan: #22d3ee;
      --green: #10b981;
      --red: #ef4444;
      --yellow: #f59e0b;
      --text: #e7e3f5;
      --text-dim: #a59fc2;
      --text-mute: #6f6890;
      --sidebar-w: 250px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 15% 10%, rgba(139, 92, 246, 0.12), transparent 45%),
        radial-gradient(circle at 85% 90%, rgba(236, 72, 153, 0.1), transparent 45%);
      pointer-events: none;
      z-index: 0;
    }

    a { color: inherit; text-decoration: none; }

    /* ============== TOPBAR ============== */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 90;
      backdrop-filter: blur(14px);
      background: rgba(10, 6, 18, 0.85);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      gap: 12px;
    }

    .topbar-left { display: flex; align-items: center; gap: 12px; }

    .menu-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: 0.25s;
      font-size: 1rem;
    }

    .menu-btn:hover {
      border-color: var(--purple);
      background: rgba(139, 92, 246, 0.1);
    }

    .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 0.95rem; }

    .logo-mark {
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 900;
      color: #fff;
      font-size: 1rem;
      box-shadow: 0 0 16px rgba(139, 92, 246, 0.5);
    }

    .logo-text {
      background: linear-gradient(135deg, #fff, var(--purple-2));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: 0.4px;
      display: none;
    }

    .topbar-right { display: flex; align-items: center; gap: 10px; }

    .coins-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 7px 12px;
      border-radius: 999px;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.35);
      color: #fbbf24;
      font-size: 0.83rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .coins-badge small { color: var(--text-mute); font-weight: 500; }

    .avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 800;
      color: #fff;
      font-size: 0.85rem;
      text-transform: uppercase;
      cursor: pointer;
      border: 2px solid rgba(139, 92, 246, 0.4);
    }

    /* ============== SIDEBAR ============== */
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sidebar-w);
      background: linear-gradient(180deg, #0d0820 0%, #100a26 100%);
      border-right: 1px solid var(--border);
      padding: 20px 14px;
      z-index: 200;
      transform: translateX(-100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }

    .sidebar.open { transform: translateX(0); }

    .sidebar-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 8px 20px;
      margin-bottom: 10px;
      border-bottom: 1px solid var(--border-soft);
    }

    .sidebar-logo .logo-mark { width: 36px; height: 36px; font-size: 1.05rem; }
    .sidebar-logo .logo-text { display: block; font-weight: 800; font-size: 0.95rem; }

    .sidebar-nav { display: flex; flex-direction: column; gap: 4px; flex: 1; }

    .nav-section {
      font-size: 0.68rem;
      color: var(--text-mute);
      text-transform: uppercase;
      letter-spacing: 1.2px;
      padding: 14px 10px 6px;
      font-weight: 700;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 11px 12px;
      border-radius: 10px;
      color: var(--text-dim);
      font-size: 0.88rem;
      font-weight: 500;
      transition: 0.2s;
      position: relative;
    }

    .sidebar-link .icon { width: 20px; text-align: center; font-size: 1.05rem; }
    .sidebar-link:hover { background: rgba(139, 92, 246, 0.1); color: var(--purple-2); }

    .sidebar-link.active {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.22), rgba(236, 72, 153, 0.15));
      color: #fff;
      border: 1px solid rgba(139, 92, 246, 0.35);
      box-shadow: 0 4px 18px rgba(139, 92, 246, 0.2);
    }

    .sidebar-link.active::before {
      content: '';
      position: absolute;
      left: -14px;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 22px;
      background: linear-gradient(180deg, var(--purple), var(--pink));
      border-radius: 0 3px 3px 0;
    }

    .sidebar-footer { border-top: 1px solid var(--border-soft); padding-top: 10px; margin-top: 10px; }
    .sidebar-footer .sidebar-link { color: #f87171; }
    .sidebar-footer .sidebar-link:hover { background: rgba(239, 68, 68, 0.1); color: #fca5a5; }

    /* ============== OVERLAY ============== */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(3px);
      z-index: 150;
      opacity: 0;
      visibility: hidden;
      transition: 0.3s;
    }

    .overlay.show { opacity: 1; visibility: visible; }

    /* ============== MAIN ============== */
    .main {
      position: relative;
      z-index: 1;
      padding: 20px 16px 40px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .page-head { margin-bottom: 22px; }

    .page-head h1 {
      font-size: clamp(1.3rem, 4vw, 1.75rem);
      font-weight: 800;
      margin-bottom: 6px;
      letter-spacing: -0.3px;
    }

    .page-head h1 span {
      background: linear-gradient(135deg, var(--purple-2), var(--pink));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .page-head p { color: var(--text-dim); font-size: 0.9rem; }

    /* ============== BALANCE BANNER ============== */
    .balance-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 18px;
      border-radius: 14px;
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.12), rgba(236, 72, 153, 0.08));
      border: 1px solid rgba(245, 158, 11, 0.3);
      margin-bottom: 22px;
      flex-wrap: wrap;
    }

    .balance-banner .left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .balance-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      display: grid;
      place-items: center;
      font-size: 1.3rem;
      box-shadow: 0 4px 16px rgba(245, 158, 11, 0.4);
      flex-shrink: 0;
    }

    .balance-label {
      font-size: 0.78rem;
      color: var(--text-mute);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      font-weight: 700;
      margin-bottom: 3px;
    }

    .balance-value {
      font-size: 1.35rem;
      font-weight: 800;
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .balance-value small {
      color: var(--text-mute);
      font-weight: 500;
      font-size: 0.8rem;
      -webkit-text-fill-color: var(--text-mute);
    }

    .balance-banner a {
      padding: 9px 14px;
      border-radius: 10px;
      background: transparent;
      border: 1px solid rgba(245, 158, 11, 0.4);
      color: #fbbf24;
      font-size: 0.82rem;
      font-weight: 600;
      transition: 0.25s;
    }

    .balance-banner a:hover {
      background: rgba(245, 158, 11, 0.15);
      border-color: #fbbf24;
    }

    /* ============== PLANS GRID ============== */
    .plans-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .plan-card {
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 22px 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      transition: 0.3s;
      position: relative;
      overflow: hidden;
      animation: fadeIn 0.4s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .plan-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--purple), var(--pink), var(--cyan));
      opacity: 0;
      transition: 0.3s;
    }

    .plan-card:hover {
      transform: translateY(-6px);
      border-color: rgba(139, 92, 246, 0.55);
      box-shadow: 0 15px 40px rgba(139, 92, 246, 0.22);
    }

    .plan-card:hover::before { opacity: 1; }

    .plan-card.featured {
      border-color: rgba(245, 158, 11, 0.45);
      box-shadow: 0 8px 30px rgba(245, 158, 11, 0.15);
    }

    .plan-card.featured::before {
      background: linear-gradient(90deg, #fbbf24, #f59e0b);
      opacity: 1;
    }

    .featured-badge {
      position: absolute;
      top: 14px;
      right: 14px;
      padding: 5px 12px;
      border-radius: 999px;
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      color: #1a0f38;
      font-size: 0.68rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.45);
      z-index: 2;
    }

    .plan-head {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .plan-name {
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: -0.2px;
    }

    .plan-tagline {
      font-size: 0.84rem;
      color: var(--text-dim);
      line-height: 1.55;
    }

    /* ============== SPECS LIST ============== */
    .plan-specs {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 14px;
      background: rgba(139, 92, 246, 0.05);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
    }

    .spec-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-size: 0.86rem;
    }

    .spec-row .key {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--text-dim);
      font-weight: 500;
    }

    .spec-row .key .ico {
      width: 18px;
      text-align: center;
    }

    .spec-row .val {
      font-weight: 700;
      color: var(--text);
    }

    /* ============== PLAN FOOTER ============== */
    .plan-footer {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 4px;
    }

    .plan-price {
      display: flex;
      align-items: baseline;
      gap: 6px;
    }

    .plan-price .amount {
      font-size: 1.6rem;
      font-weight: 800;
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: -0.5px;
    }

    .plan-price .currency {
      font-size: 0.82rem;
      color: var(--text-mute);
      font-weight: 600;
    }

    .stock-info {
      font-size: 0.76rem;
      color: var(--text-mute);
    }

    .stock-info strong { color: #34d399; }
    .stock-info.low strong { color: #fbbf24; }
    .stock-info.empty strong { color: #f87171; }

    /* ============== BUTTONS ============== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 20px;
      border-radius: 11px;
      font-weight: 700;
      font-size: 0.88rem;
      border: none;
      cursor: pointer;
      transition: 0.25s;
      font-family: inherit;
      text-decoration: none;
      width: 100%;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--purple), var(--pink));
      color: #fff;
      box-shadow: 0 6px 22px rgba(139, 92, 246, 0.4);
    }

    .btn-primary:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(139, 92, 246, 0.55);
    }

    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      box-shadow: none;
    }

    .btn-gold {
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      color: #1a0f38;
      box-shadow: 0 6px 22px rgba(245, 158, 11, 0.4);
    }

    .btn-gold:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(245, 158, 11, 0.55);
    }

    .btn-gold:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      box-shadow: none;
    }

    /* ============== EMPTY ============== */
    .empty {
      text-align: center;
      padding: 60px 20px;
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px dashed var(--border);
      border-radius: 16px;
    }

    .empty-icon { font-size: 2.6rem; margin-bottom: 12px; opacity: 0.5; }
    .empty h3 { font-size: 1.05rem; margin-bottom: 8px; }
    .empty p { color: var(--text-dim); font-size: 0.88rem; }

    /* ============== TOASTS ============== */
    .toast-container {
      position: fixed;
      top: 74px;
      right: 14px;
      z-index: 999;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 340px;
      width: calc(100% - 28px);
    }

    .toast {
      padding: 12px 15px;
      border-radius: 12px;
      background: var(--card-2);
      border-left: 4px solid var(--purple);
      color: var(--text);
      font-size: 0.85rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      animation: slideIn 0.35s ease;
    }

    .toast.success { border-left-color: var(--green); }
    .toast.error { border-left-color: var(--red); }
    .toast.warning { border-left-color: var(--yellow); }

    @keyframes slideIn {
      from { opacity: 0; transform: translateX(40px); }
      to { opacity: 1; transform: translateX(0); }
    }

    /* ============== MODAL ============== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(6px);
      z-index: 500;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-backdrop.show { display: flex; }

    .modal {
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px solid var(--border);
      border-radius: 18px;
      max-width: 480px;
      width: 100%;
      padding: 24px;
      animation: modalIn 0.3s ease;
    }

    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }

    .modal h2 {
      font-size: 1.15rem;
      font-weight: 800;
      margin-bottom: 10px;
    }

    .modal p {
      color: var(--text-dim);
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: 14px;
    }

    .modal-info {
      background: rgba(139, 92, 246, 0.06);
      border: 1px solid var(--border-soft);
      border-radius: 10px;
      padding: 12px 14px;
      margin-bottom: 18px;
      font-size: 0.85rem;
    }

    .modal-info-row {
      display: flex;
      justify-content: space-between;
      padding: 4px 0;
      gap: 10px;
    }

    .modal-info-row .lbl { color: var(--text-mute); }
    .modal-info-row .vl { font-weight: 700; }
    .modal-info-row .vl.gold {
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .modal-actions {
      display: flex;
      gap: 10px;
    }

    .modal-actions form { flex: 1; }
    .modal-actions form button { width: 100%; }

    .btn-ghost {
      background: transparent;
      color: var(--text-dim);
      border: 1px solid var(--border);
      flex: 1;
    }

    .btn-ghost:hover {
      color: var(--purple-2);
      border-color: var(--purple);
      background: rgba(139, 92, 246, 0.1);
    }

    /* ============== RESPONSIVE ============== */
    @media (min-width: 480px) {
      .logo-text { display: block; }
      .plan-footer { flex-direction: row; align-items: center; justify-content: space-between; }
      .plan-footer .btn { width: auto; }
    }

    @media (min-width: 640px) {
      .plans-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (min-width: 900px) {
      .topbar { padding-left: calc(var(--sidebar-w) + 20px); }
      .sidebar { transform: translateX(0); }
      .menu-btn { display: none; }
      .main { padding: 26px 30px 60px; margin-left: var(--sidebar-w); max-width: none; }
      .overlay { display: none; }
      .plans-grid { grid-template-columns: repeat(3, 1fr); }
    }
  </style>
</head>
<body>

  <!-- ============== TOASTS ============== -->
  <% if (success && success.length > 0) { %>
    <div class="toast-container">
      <% success.forEach((msg) => { %>
        <div class="toast success"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="toast-container">
      <% error.forEach((msg) => { %>
        <div class="toast error"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (warning && warning.length > 0) { %>
    <div class="toast-container">
      <% warning.forEach((msg) => { %>
        <div class="toast warning"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>

  <!-- ============== OVERLAY ============== -->
  <div class="overlay" id="overlay" onclick="closeSidebar()"></div>

  <!-- ============== SIDEBAR ============== -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-mark">D</div>
      <div class="logo-text">DVARY HOSTING</div>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section">Menu</div>

      <a href="/dashboard" class="sidebar-link">
        <span class="icon">🏠</span> Dashboard
      </a>
      <a href="/bots" class="sidebar-link">
        <span class="icon">🤖</span> Deploy Bots
      </a>
      <a href="/deploy" class="sidebar-link">
        <span class="icon">🚀</span> My Deployments
      </a>
      <a href="/servers/buy" class="sidebar-link active">
        <span class="icon">🛒</span> Buy Server
      </a>
      <a href="/servers" class="sidebar-link">
        <span class="icon">🖥️</span> My Servers
      </a>
      <a href="/servers/admin-panels" class="sidebar-link">
        <span class="icon">🛡️</span> Admin Panels
      </a>
      <a href="/servers/my-panels" class="sidebar-link">
        <span class="icon">📦</span> My Panels
      </a>

      <div class="nav-section">Akaunti</div>

      <a href="/coins" class="sidebar-link">
        <span class="icon">🪙</span> Coins
      </a>
      <a href="/coins/transactions" class="sidebar-link">
        <span class="icon">📊</span> Transactions
      </a>
      <a href="/dashboard/profile" class="sidebar-link">
        <span class="icon">👤</span> Profile
      </a>
      <a href="/dashboard/settings" class="sidebar-link">
        <span class="icon">⚙️</span> Settings
      </a>
    </nav>

    <div class="sidebar-footer">
      <% if (isAdmin) { %>
        <a href="/admin/dashboard" class="sidebar-link">
          <span class="icon">🔑</span> Admin Panel
        </a>
      <% } %>
      <a href="/auth/logout" class="sidebar-link">
        <span class="icon">🚪</span> Logout
      </a>
    </div>
  </aside>

  <!-- ============== TOPBAR ============== -->
  <header class="topbar">
    <div class="topbar-left">
      <button class="menu-btn" onclick="openSidebar()" aria-label="Menu">☰</button>
      <div class="logo">
        <div class="logo-mark">D</div>
        <span class="logo-text">DVARY HOSTING</span>
      </div>
    </div>

    <div class="topbar-right">
      <a href="/coins" class="coins-badge">
        🪙 <%= user.coins %> <small>coins</small>
      </a>
      <a href="/dashboard/profile" class="avatar" title="<%= user.username %>">
        <%= user.username.charAt(0) %>
      </a>
    </div>
  </header>

  <!-- ============== MAIN ============== -->
  <main class="main">

    <div class="page-head">
      <h1>Buy <span>Server</span> 🛒</h1>
      <p>Chagua hosting plan inayokufaa. Tumia coins zako kununua server papo hapo.</p>
    </div>

    <!-- BALANCE BANNER -->
    <div class="balance-banner">
      <div class="left">
        <div class="balance-icon">🪙</div>
        <div>
          <div class="balance-label">Balance Yako</div>
          <div class="balance-value"><%= user.coins %> <small>coins</small></div>
        </div>
      </div>
      <a href="/coins">Ona Coins →</a>
    </div>

    <!-- PLANS -->
    <% if (plans && plans.length > 0) { %>
      <div class="plans-grid">
        <% plans.forEach((plan) => { %>
          <div class="plan-card <%= plan.featured ? 'featured' : '' %>">

            <% if (plan.featured) { %>
              <div class="featured-badge">⭐ Featured</div>
            <% } %>

            <div class="plan-head">
              <div class="plan-name"><%= plan.name %></div>
              <div class="plan-tagline"><%= plan.shortDescription || plan.description %></div>
            </div>

            <div class="plan-specs">
              <div class="spec-row">
                <span class="key"><span class="ico">💾</span> RAM</span>
                <span class="val"><%= plan.ram %> MB</span>
              </div>
              <div class="spec-row">
                <span class="key"><span class="ico">⚡</span> CPU</span>
                <span class="val"><%= plan.cpu %>%</span>
              </div>
              <div class="spec-row">
                <span class="key"><span class="ico">💿</span> Disk</span>
                <span class="val"><%= plan.disk %> MB</span>
              </div>
            </div>

            <div class="plan-footer">
              <div>
                <div class="plan-price">
                  <span class="amount"><%= plan.price %></span>
                  <span class="currency">coins</span>
                </div>
                <div class="stock-info <%= plan.stock !== null && plan.stock <= 0 ? 'empty' : (plan.stock !== null && plan.stock <= 5 ? 'low' : '') %>">
                  <% if (plan.stock === null) { %>
                    <strong>Ipo</strong> (stock haina kikomo)
                  <% } else if (plan.stock <= 0) { %>
                    <strong>Imeisha stock</strong>
                  <% } else { %>
                    Stock: <strong><%= plan.stock %></strong> zilizobaki
                  <% } %>
                </div>
              </div>

              <% if (plan.stock !== null && plan.stock <= 0) { %>
                <button class="btn btn-primary" disabled>Imeisha Stock</button>
              <% } else if (user.coins >= plan.price) { %>
                <button
                  type="button"
                  class="btn btn-gold"
                  onclick="openBuyModal('<%= plan._id %>', '<%= plan.name.replace(/'/g, "\\'") %>', <%= plan.price %>, <%= user.coins %>, <%= plan.ram %>, <%= plan.cpu %>, <%= plan.disk %>)"
                >
                  Nunua Sasa →
                </button>
              <% } else { %>
                <button class="btn btn-primary" disabled title="Coins hazitoshi">
                  Coins Hazitoshi
                </button>
              <% } %>
            </div>

          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty">
        <div class="empty-icon">📭</div>
        <h3>Hakuna hosting plans bado</h3>
        <p>Admin bado hajaongeza plans. Tafadhali angalia tena baadaye.</p>
      </div>
    <% } %>

  </main>

  <!-- ============== MODAL ============== -->
  <div class="modal-backdrop" id="buyModal">
    <div class="modal">
      <h2>Thibitisha Ununuzi</h2>
      <p>Angalia taarifa za plan kabla ya kununua. Coins zitatolewa mara moja.</p>

      <div class="modal-info">
        <div class="modal-info-row">
          <span class="lbl">Plan</span>
          <span class="vl" id="modalPlanName">-</span>
        </div>
        <div class="modal-info-row">
          <span class="lbl">RAM</span>
          <span class="vl" id="modalRam">-</span>
        </div>
        <div class="modal-info-row">
          <span class="lbl">CPU</span>
          <span class="vl" id="modalCpu">-</span>
        </div>
        <div class="modal-info-row">
          <span class="lbl">Disk</span>
          <span class="vl" id="modalDisk">-</span>
        </div>
        <div class="modal-info-row" style="border-top: 1px solid var(--border-soft); margin-top: 6px; padding-top: 8px;">
          <span class="lbl">Bei</span>
          <span class="vl gold" id="modalPrice">-</span>
        </div>
        <div class="modal-info-row">
          <span class="lbl">Balance yako</span>
          <span class="vl" id="modalBalance">-</span>
        </div>
        <div class="modal-info-row">
          <span class="lbl">Itabaki</span>
          <span class="vl" id="modalRemain">-</span>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" onclick="closeBuyModal()">Ghairi</button>
        <form action="/servers/buy" method="POST" id="buyForm">
          <input type="hidden" name="planId" id="modalPlanId" value="" />
          <button type="submit" class="btn btn-gold" id="modalSubmit">
            <span class="btn-text">Thibitisha</span>
            <span class="spinner" style="display: none; width: 16px; height: 16px; border: 2px solid rgba(0,0,0,0.3); border-top-color: #1a0f38; border-radius: 50%; animation: spin 0.7s linear infinite;"></span>
          </button>
        </form>
      </div>
    </div>
  </div>

  <style>
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>

  <script>
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');
    const buyModal = document.getElementById('buyModal');

    function openSidebar() {
      sidebar.classList.add('open');
      overlay.classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      sidebar.classList.remove('open');
      overlay.classList.remove('show');
      document.body.style.overflow = '';
    }

    function openBuyModal(planId, planName, price, balance, ram, cpu, disk) {
      document.getElementById('modalPlanId').value = planId;
      document.getElementById('modalPlanName').textContent = planName;
      document.getElementById('modalRam').textContent = ram + ' MB';
      document.getElementById('modalCpu').textContent = cpu + '%';
      document.getElementById('modalDisk').textContent = disk + ' MB';
      document.getElementById('modalPrice').textContent = price + ' coins';
      document.getElementById('modalBalance').textContent = balance + ' coins';
      document.getElementById('modalRemain').textContent = (balance - price) + ' coins';
      buyModal.classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function closeBuyModal() {
      buyModal.classList.remove('show');
      document.body.style.overflow = '';
    }

    // Funga modal kwa kubonyeza nje
    buyModal.addEventListener('click', (e) => {
      if (e.target === buyModal) closeBuyModal();
    });

    // Loading state kwenye submit
    document.getElementById('buyForm').addEventListener('submit', function () {
      const btn = document.getElementById('modalSubmit');
      btn.disabled = true;
      btn.querySelector('.btn-text').textContent = 'Inaunda server...';
      btn.querySelector('.spinner').style.display = 'inline-block';
    });

    setTimeout(() => {
      document.querySelectorAll('.toast').forEach((el) => {
        el.style.transition = 'opacity 0.4s, transform 0.4s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(40px)';
        setTimeout(() => el.remove(), 400);
      });
    }, 4000);

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 900) closeSidebar();
    });
  </script>
</body>
</html>
