<!DOCTYPE html>
<html lang="sw">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    :root {
      --bg: #0a0612;
      --bg-2: #0f0a1f;
      --card: #150d2b;
      --card-2: #1b1138;
      --border: rgba(139, 92, 246, 0.2);
      --border-soft: rgba(139, 92, 246, 0.12);
      --purple: #8b5cf6;
      --purple-2: #a78bfa;
      --pink: #ec4899;
      --cyan: #22d3ee;
      --green: #10b981;
      --red: #ef4444;
      --yellow: #f59e0b;
      --text: #e7e3f5;
      --text-dim: #a59fc2;
      --text-mute: #6f6890;
      --sidebar-w: 260px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 15% 10%, rgba(139, 92, 246, 0.12), transparent 45%),
        radial-gradient(circle at 85% 90%, rgba(236, 72, 153, 0.1), transparent 45%);
      pointer-events: none;
      z-index: 0;
    }

    a { color: inherit; text-decoration: none; }

    /* ============== TOPBAR ============== */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 90;
      backdrop-filter: blur(14px);
      background: rgba(10, 6, 18, 0.85);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      gap: 12px;
    }

    .topbar-left { display: flex; align-items: center; gap: 12px; }

    .menu-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: 0.25s;
      font-size: 1rem;
    }

    .menu-btn:hover {
      border-color: var(--purple);
      background: rgba(139, 92, 246, 0.1);
    }

    .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 0.95rem; }

    .logo-mark {
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 900;
      color: #fff;
      font-size: 1rem;
      box-shadow: 0 0 16px rgba(139, 92, 246, 0.5);
    }

    .logo-text {
      background: linear-gradient(135deg, #fff, var(--purple-2));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      letter-spacing: 0.4px;
      display: none;
    }

    .admin-tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 9px;
      border-radius: 999px;
      background: rgba(236, 72, 153, 0.15);
      border: 1px solid rgba(236, 72, 153, 0.35);
      color: #f472b6;
      font-size: 0.65rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-left: 4px;
      display: none;
    }

    .topbar-right { display: flex; align-items: center; gap: 10px; }

    .user-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px 6px 6px;
      border-radius: 999px;
      background: rgba(139, 92, 246, 0.1);
      border: 1px solid var(--border);
      transition: 0.25s;
    }

    .user-btn:hover { border-color: var(--purple); }

    .user-avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 800;
      color: #fff;
      font-size: 0.78rem;
      text-transform: uppercase;
    }

    .user-name { font-size: 0.83rem; font-weight: 700; display: none; }

    /* ============== SIDEBAR ============== */
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--sidebar-w);
      background: linear-gradient(180deg, #0d0820 0%, #100a26 100%);
      border-right: 1px solid var(--border);
      padding: 20px 14px;
      z-index: 200;
      transform: translateX(-100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }

    .sidebar.open { transform: translateX(0); }

    .sidebar-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 8px 20px;
      margin-bottom: 10px;
      border-bottom: 1px solid var(--border-soft);
    }

    .sidebar-logo .logo-mark { width: 36px; height: 36px; font-size: 1.05rem; }
    .sidebar-logo .logo-text { display: block; font-weight: 800; font-size: 0.95rem; }

    .sidebar-badge {
      display: inline-block;
      margin: 0 8px 12px;
      padding: 5px 10px;
      border-radius: 8px;
      background: linear-gradient(135deg, rgba(236, 72, 153, 0.15), rgba(139, 92, 246, 0.15));
      border: 1px solid rgba(236, 72, 153, 0.3);
      color: #f472b6;
      font-size: 0.7rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      text-align: center;
    }

    .sidebar-nav { display: flex; flex-direction: column; gap: 4px; flex: 1; }

    .nav-section {
      font-size: 0.68rem;
      color: var(--text-mute);
      text-transform: uppercase;
      letter-spacing: 1.2px;
      padding: 14px 10px 6px;
      font-weight: 700;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 11px 12px;
      border-radius: 10px;
      color: var(--text-dim);
      font-size: 0.88rem;
      font-weight: 500;
      transition: 0.2s;
      position: relative;
    }

    .sidebar-link .icon { width: 20px; text-align: center; font-size: 1.05rem; }
    .sidebar-link:hover { background: rgba(139, 92, 246, 0.1); color: var(--purple-2); }

    .sidebar-link.active {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.22), rgba(236, 72, 153, 0.15));
      color: #fff;
      border: 1px solid rgba(139, 92, 246, 0.35);
      box-shadow: 0 4px 18px rgba(139, 92, 246, 0.2);
    }

    .sidebar-link.active::before {
      content: '';
      position: absolute;
      left: -14px;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 22px;
      background: linear-gradient(180deg, var(--purple), var(--pink));
      border-radius: 0 3px 3px 0;
    }

    .sidebar-footer { border-top: 1px solid var(--border-soft); padding-top: 10px; margin-top: 10px; }
    .sidebar-footer .sidebar-link { color: #f87171; }
    .sidebar-footer .sidebar-link:hover { background: rgba(239, 68, 68, 0.1); color: #fca5a5; }

    /* ============== OVERLAY ============== */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(3px);
      z-index: 150;
      opacity: 0;
      visibility: hidden;
      transition: 0.3s;
    }

    .overlay.show { opacity: 1; visibility: visible; }

    /* ============== MAIN ============== */
    .main {
      position: relative;
      z-index: 1;
      padding: 20px 16px 40px;
      max-width: 1300px;
      margin: 0 auto;
    }

    .page-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 22px;
      flex-wrap: wrap;
    }

    .page-head h1 {
      font-size: clamp(1.3rem, 4vw, 1.75rem);
      font-weight: 800;
      margin-bottom: 6px;
      letter-spacing: -0.3px;
    }

    .page-head h1 span {
      background: linear-gradient(135deg, var(--purple-2), var(--pink));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .page-head p { color: var(--text-dim); font-size: 0.9rem; }

    /* ============== FILTERS ============== */
    .filters-card {
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px;
      margin-bottom: 18px;
    }

    .filters-row {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .search-wrap { position: relative; width: 100%; }

    .search-wrap input {
      width: 100%;
      padding: 11px 14px 11px 40px;
      border-radius: 10px;
      background: rgba(10, 6, 18, 0.6);
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 0.88rem;
      font-family: inherit;
      outline: none;
      transition: 0.25s;
    }

    .search-wrap input:focus {
      border-color: var(--purple);
      box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
    }

    .search-wrap input::placeholder { color: var(--text-mute); }

    .search-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-mute);
      font-size: 0.95rem;
      pointer-events: none;
    }

    .filter-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .filter-select {
      padding: 10px 12px;
      border-radius: 10px;
      background: rgba(10, 6, 18, 0.6);
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 0.85rem;
      font-family: inherit;
      outline: none;
      cursor: pointer;
      flex: 1;
      min-width: 130px;
    }

    .filter-select:focus { border-color: var(--purple); }
    .filter-select option { background: var(--card-2); color: var(--text); }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px 16px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.83rem;
      border: none;
      cursor: pointer;
      transition: 0.25s;
      font-family: inherit;
      text-decoration: none;
      white-space: nowrap;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--purple), var(--pink));
      color: #fff;
      box-shadow: 0 4px 18px rgba(139, 92, 246, 0.35);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(139, 92, 246, 0.5);
    }

    .btn-ghost {
      background: transparent;
      color: var(--text-dim);
      border: 1px solid var(--border);
    }

    .btn-ghost:hover {
      color: var(--purple-2);
      border-color: var(--purple);
      background: rgba(139, 92, 246, 0.1);
    }

    /* ============== RESULTS META ============== */
    .results-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 12px;
      font-size: 0.85rem;
      color: var(--text-dim);
      flex-wrap: wrap;
    }

    .results-meta strong { color: var(--purple-2); }

    /* ============== USERS LIST ============== */
    .users-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 22px;
    }

    .user-card {
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px;
      transition: 0.25s;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .user-card:hover {
      transform: translateY(-2px);
      border-color: rgba(139, 92, 246, 0.5);
      box-shadow: 0 8px 22px rgba(139, 92, 246, 0.15);
    }

    .user-main {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .user-avatar-lg {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--purple), var(--pink));
      display: grid;
      place-items: center;
      font-weight: 800;
      color: #fff;
      font-size: 1.1rem;
      text-transform: uppercase;
      flex-shrink: 0;
      border: 2px solid rgba(139, 92, 246, 0.4);
    }

    .user-info { flex: 1; min-width: 0; }

    .user-name-lg {
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 3px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .user-email {
      font-size: 0.78rem;
      color: var(--text-mute);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .user-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding-top: 10px;
      border-top: 1px dashed var(--border-soft);
      flex-wrap: wrap;
    }

    .user-meta {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      font-size: 0.78rem;
      color: var(--text-mute);
    }

    .user-meta .coins {
      font-weight: 800;
      color: #fbbf24;
      background: rgba(245, 158, 11, 0.1);
      padding: 3px 9px;
      border-radius: 999px;
      border: 1px solid rgba(245, 158, 11, 0.25);
    }

    .user-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .badge {
      display: inline-block;
      font-size: 0.66rem;
      padding: 3px 9px;
      border-radius: 999px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      white-space: nowrap;
    }

    .badge-admin { background: rgba(236, 72, 153, 0.15); color: #f472b6; border: 1px solid rgba(236, 72, 153, 0.3); }
    .badge-user  { background: rgba(139, 92, 246, 0.15); color: var(--purple-2); border: 1px solid rgba(139, 92, 246, 0.3); }
    .badge-active { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
    .badge-suspended { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
    .badge-banned { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }

    /* ============== PAGINATION ============== */
    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .page-link {
      padding: 8px 13px;
      border-radius: 9px;
      background: rgba(139, 92, 246, 0.08);
      border: 1px solid var(--border);
      color: var(--text-dim);
      font-size: 0.82rem;
      font-weight: 600;
      transition: 0.2s;
    }

    .page-link:hover {
      border-color: var(--purple);
      color: var(--purple-2);
      background: rgba(139, 92, 246, 0.15);
    }

    .page-link.active {
      background: linear-gradient(135deg, var(--purple), var(--pink));
      border-color: transparent;
      color: #fff;
      box-shadow: 0 4px 16px rgba(139, 92, 246, 0.4);
    }

    .page-info {
      font-size: 0.8rem;
      color: var(--text-mute);
      width: 100%;
      text-align: center;
      margin-top: 8px;
    }

    /* ============== EMPTY ============== */
    .empty {
      text-align: center;
      padding: 50px 20px;
      background: linear-gradient(160deg, var(--card), var(--card-2));
      border: 1px dashed var(--border);
      border-radius: 16px;
    }

    .empty-icon { font-size: 2.6rem; margin-bottom: 12px; opacity: 0.5; }
    .empty h3 { font-size: 1.05rem; margin-bottom: 8px; }
    .empty p { color: var(--text-dim); font-size: 0.88rem; }

    /* ============== TOASTS ============== */
    .toast-container {
      position: fixed;
      top: 74px;
      right: 14px;
      z-index: 999;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 340px;
      width: calc(100% - 28px);
    }

    .toast {
      padding: 12px 15px;
      border-radius: 12px;
      background: var(--card-2);
      border-left: 4px solid var(--purple);
      color: var(--text);
      font-size: 0.85rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      animation: slideIn 0.35s ease;
    }

    .toast.success { border-left-color: var(--green); }
    .toast.error { border-left-color: var(--red); }
    .toast.warning { border-left-color: var(--yellow); }

    @keyframes slideIn {
      from { opacity: 0; transform: translateX(40px); }
      to { opacity: 1; transform: translateX(0); }
    }

    /* ============== RESPONSIVE ============== */
    @media (min-width: 480px) {
      .logo-text { display: block; }
      .admin-tag { display: inline-flex; }
      .user-name { display: block; }
      .filters-row { flex-direction: row; align-items: center; }
      .search-wrap { flex: 1; min-width: 220px; }
      .filter-group { flex: 0 1 auto; }
      .filter-select { flex: 0 1 auto; min-width: 130px; }
    }

    @media (min-width: 700px) {
      .user-card {
        flex-direction: row;
        align-items: center;
      }
      .user-main { flex: 1; }
      .user-footer {
        border-top: none;
        padding-top: 0;
        flex-direction: column;
        align-items: flex-end;
      }
    }

    @media (min-width: 900px) {
      .topbar { padding-left: calc(var(--sidebar-w) + 20px); }
      .sidebar { transform: translateX(0); }
      .menu-btn { display: none; }
      .main { padding: 26px 30px 60px; margin-left: var(--sidebar-w); max-width: none; }
      .overlay { display: none; }
    }
  </style>
</head>
<body>

  <!-- ============== TOASTS ============== -->
  <% if (success && success.length > 0) { %>
    <div class="toast-container">
      <% success.forEach((msg) => { %>
        <div class="toast success"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div class="toast-container">
      <% error.forEach((msg) => { %>
        <div class="toast error"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>
  <% if (warning && warning.length > 0) { %>
    <div class="toast-container">
      <% warning.forEach((msg) => { %>
        <div class="toast warning"><%= msg %></div>
      <% }); %>
    </div>
  <% } %>

  <!-- ============== OVERLAY ============== -->
  <div class="overlay" id="overlay" onclick="closeSidebar()"></div>

  <!-- ============== SIDEBAR ============== -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-mark">D</div>
      <div class="logo-text">DVARY HOSTING</div>
    </div>
    <div class="sidebar-badge">🔑 Admin Panel</div>

    <nav class="sidebar-nav">
      <div class="nav-section">Usimamizi</div>

      <a href="/admin/dashboard" class="sidebar-link">
        <span class="icon">📊</span> Dashboard
      </a>
      <a href="/admin/users" class="sidebar-link active">
        <span class="icon">👥</span> Users
      </a>
      <a href="/admin/bots" class="sidebar-link">
        <span class="icon">🤖</span> Bots
      </a>
      <a href="/admin/deployments" class="sidebar-link">
        <span class="icon">🚀</span> Deployments
      </a>
      <a href="/admin/servers" class="sidebar-link">
        <span class="icon">🖥️</span> Servers
      </a>

      <div class="nav-section">Bidhaa</div>

      <a href="/admin/hosting-plans" class="sidebar-link">
        <span class="icon">📦</span> Hosting Plans
      </a>
      <a href="/admin/admin-panels" class="sidebar-link">
        <span class="icon">🛡️</span> Admin Panels
      </a>

      <div class="nav-section">Fedha</div>

      <a href="/admin/transactions" class="sidebar-link">
        <span class="icon">💰</span> Transactions
      </a>

      <div class="nav-section">Mfumo</div>

      <a href="/admin/settings" class="sidebar-link">
        <span class="icon">⚙️</span> Settings
      </a>
    </nav>

    <div class="sidebar-footer">
      <a href="/dashboard" class="sidebar-link">
        <span class="icon">👤</span> User View
      </a>
      <a href="/auth/logout" class="sidebar-link">
        <span class="icon">🚪</span> Logout
      </a>
    </div>
  </aside>

  <!-- ============== TOPBAR ============== -->
  <header class="topbar">
    <div class="topbar-left">
      <button class="menu-btn" onclick="openSidebar()" aria-label="Menu">☰</button>
      <div class="logo">
        <div class="logo-mark">D</div>
        <span class="logo-text">DVARY HOSTING</span>
        <span class="admin-tag">🔑 Admin</span>
      </div>
    </div>

    <div class="topbar-right">
      <a href="/dashboard/profile" class="user-btn">
        <div class="user-avatar"><%= user.username.charAt(0) %></div>
        <span class="user-name"><%= user.username %></span>
      </a>
    </div>
  </header>

  <!-- ============== MAIN ============== -->
  <main class="main">

    <div class="page-head">
      <div>
        <h1>Users <span>Management</span> 👥</h1>
        <p>Simamia users wote wa DVARY HOSTING — status, role, na coins.</p>
      </div>
    </div>

    <!-- FILTERS -->
    <form class="filters-card" method="GET" action="/admin/users">
      <div class="filters-row">
        <div class="search-wrap">
          <span class="search-icon">🔍</span>
          <input
            type="text"
            name="search"
            placeholder="Tafuta username au email..."
            value="<%= filters.search %>"
          />
        </div>

        <div class="filter-group">
          <select name="status" class="filter-select">
            <option value="" <%= !filters.status || filters.status === 'all' ? 'selected' : '' %>>Status: Zote</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
            <option value="banned" <%= filters.status === 'banned' ? 'selected' : '' %>>Banned</option>
          </select>

          <select name="role" class="filter-select">
            <option value="" <%= !filters.role || filters.role === 'all' ? 'selected' : '' %>>Role: Zote</option>
            <option value="user" <%= filters.role === 'user' ? 'selected' : '' %>>User</option>
            <option value="admin" <%= filters.role === 'admin' ? 'selected' : '' %>>Admin</option>
          </select>

          <button type="submit" class="btn btn-primary">Chuja</button>
          <a href="/admin/users" class="btn btn-ghost">Reset</a>
        </div>
      </div>
    </form>

    <!-- RESULTS META -->
    <div class="results-meta">
      <div>Users <strong><%= users.length %></strong> wamepatikana</div>
      <div>Jumla: <strong><%= pagination.total %></strong></div>
    </div>

    <!-- USERS LIST -->
    <% if (users && users.length > 0) { %>
      <div class="users-list">
        <% users.forEach((u) => { %>
          <div class="user-card">
            <div class="user-main">
              <div class="user-avatar-lg"><%= u.username.charAt(0) %></div>
              <div class="user-info">
                <div class="user-name-lg"><%= u.username %></div>
                <div class="user-email"><%= u.email %></div>
              </div>
            </div>

            <div class="user-footer">
              <div class="user-meta">
                <% if (u.role === 'admin') { %>
                  <span class="badge badge-admin">🔑 Admin</span>
                <% } else { %>
                  <span class="badge badge-user">👤 User</span>
                <% } %>

                <% if (u.status === 'active') { %>
                  <span class="badge badge-active">✅ Active</span>
                <% } else if (u.status === 'suspended') { %>
                  <span class="badge badge-suspended">⏸️ Suspended</span>
                <% } else if (u.status === 'banned') { %>
                  <span class="badge badge-banned">🚫 Banned</span>
                <% } %>

                <span class="coins">🪙 <%= u.coins %></span>
              </div>

              <div class="user-actions">
                <a href="/admin/users/<%= u._id %>" class="btn btn-primary">Angalia →</a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- PAGINATION -->
      <% if (pagination.totalPages > 1) { %>
        <div class="pagination">
          <% if (pagination.hasPrev) { %>
            <a
              href="/admin/users?page=<%= pagination.currentPage - 1 %><%= filters.search ? '&search=' + filters.search : '' %><%= filters.status && filters.status !== 'all' ? '&status=' + filters.status : '' %><%= filters.role && filters.role !== 'all' ? '&role=' + filters.role : '' %>"
              class="page-link"
            >← Nyuma</a>
          <% } %>

          <span class="page-link active"><%= pagination.currentPage %> / <%= pagination.totalPages %></span>

          <% if (pagination.hasNext) { %>
            <a
              href="/admin/users?page=<%= pagination.currentPage + 1 %><%= filters.search ? '&search=' + filters.search : '' %><%= filters.status && filters.status !== 'all' ? '&status=' + filters.status : '' %><%= filters.role && filters.role !== 'all' ? '&role=' + filters.role : '' %>"
              class="page-link"
            >Mbele →</a>
          <% } %>

          <div class="page-info">Ukurasa <%= pagination.currentPage %> kati ya <%= pagination.totalPages %></div>
        </div>
      <% } %>

    <% } else { %>
      <div class="empty">
        <div class="empty-icon">👥</div>
        <h3>Hakuna users waliopatikana</h3>
        <p>
          <% if (filters.search || (filters.status && filters.status !== 'all') || (filters.role && filters.role !== 'all')) { %>
            Jaribu kubadilisha filters zako.
          <% } else { %>
            Hakuna users bado kwenye mfumo.
          <% } %>
        </p>
      </div>
    <% } %>

  </main>

  <script>
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');

    function openSidebar() {
      sidebar.classList.add('open');
      overlay.classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      sidebar.classList.remove('open');
      overlay.classList.remove('show');
      document.body.style.overflow = '';
    }

    const searchInput = document.querySelector('input[name="search"]');
    if (searchInput) {
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          searchInput.form.submit();
        }
      });
    }

    setTimeout(() => {
      document.querySelectorAll('.toast').forEach((el) => {
        el.style.transition = 'opacity 0.4s, transform 0.4s';
        el.style.opacity = '0';
        el.style.transform = 'translateX(40px)';
        setTimeout(() => el.remove(), 400);
      });
    }, 4000);

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 900) closeSidebar();
    });
  </script>
</body>
</html>
